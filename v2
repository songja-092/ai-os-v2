def cmd_plan(args):
    v2_root = os.path.dirname(os.path.abspath(__file__))
    run_file = os.path.join(v2_root, "runs", args.run_id, "run.yml")
    if not os.path.exists(run_file):
        print(f"Error: Run '{args.run_id}' not found.", file=sys.stderr)
        sys.exit(1)

    run_data = read_yaml(run_file)
    req_status = run_data.get("requirements_status")
    approval_info = run_data.get("approval", {})
    app_status = approval_info.get("status")
    app_version = approval_info.get("approved_version")
    req_version = run_data.get("requirements_version")

    if run_data.get("status") in ["cancelled", "failed"] or req_status == "rejected":
        print("Error: Cannot start planning on a cancelled, failed, or rejected run.", file=sys.stderr)
        sys.exit(1)

    project_path = run_data.get("project", {}).get("path")
    recorded_spec_path = run_data.get("requirements_artifact")
    feature_dir, actual_spec_path, _ = resolve_feature_artifacts(project_path)

    next_allowed = (req_status == "approved" and
                    app_status == "approved" and
                    app_version == req_version)

    if not next_allowed:
        print("Error: Specification not approved or version mismatch.", file=sys.stderr)
        print(f"  Requirements Status: {req_status}", file=sys.stderr)
        print(f"  Approved Version: {app_version} (Current: {req_version})", file=sys.stderr)
        sys.exit(1)

    if (
        not recorded_spec_path
        or os.path.realpath(recorded_spec_path) != os.path.realpath(actual_spec_path or "")
        or not os.path.isfile(recorded_spec_path)
        or os.path.getsize(recorded_spec_path) == 0
    ):
        print("Error: Approved specification Artifact is missing or does not match the Run.", file=sys.stderr)
        sys.exit(1)

    print(f"Plan 단계 진입 허용 (Run ID: {args.run_id})")
    print(f"동일 V2 Run ID: {args.run_id}")
    print(f"승인된 Requirements Version: {req_version}")

    run_dir_path = os.path.dirname(run_file)
    log_file_path = os.path.join(run_dir_path, "skill-speckit-plan.log")
    try:
        non_interactive_guard = (
            "\n\n[IMPORTANT: You are running in an automated non-interactive batch environment. "
            "Do NOT ask any clarification questions. "
            "Resolve any ambiguities by making reasonable assumptions. "
            "Produce the final plan.md file immediately and exit successfully.]"
        )
        plan_prompt = "Create the technical plan for the currently active approved specification." + non_interactive_guard
        skill_result = run_skill(
            project_path,
            "speckit-plan",
            plan_prompt,
            600,
            [feature_dir, ".specify/feature.json"],
        )
    except Exception as e:
        run_data["status"] = "failed"
        run_data["failure_reason"] = str(e)
        write_yaml(run_file, run_data)
        print(f"Error executing speckit-plan: {e}", file=sys.stderr)
        sys.exit(1)

    write_skill_log(log_file_path, "speckit-plan", skill_result)
    plan_path = os.path.join(project_path, feature_dir, "plan.md")
    has_plan = os.path.isfile(plan_path) and os.path.getsize(plan_path) > 0

    if skill_result["returncode"] != 0 or skill_result["unexpected_changes"] or not has_plan:
        run_data["status"] = "failed"
        run_data["failure_reason"] = "Plan Skill execution or Artifact validation failed."
        write_yaml(run_file, run_data)
        print("Error: Technical Plan generation failed.", file=sys.stderr)
        print(f"Exit Code: {skill_result['returncode']}", file=sys.stderr)
        print(f"Log: {log_file_path}", file=sys.stderr)
        sys.exit(1)

    run_data["planning_artifact"] = plan_path
    run_data["stage"] = "planning"
    run_data["status"] = "active"
    write_yaml(run_file, run_data)

    print(f"Success: Technical Plan generated successfully at {plan_path}")

# Update Run status logic
def update_run_status(run_id, target_status):
    v2_root = os.path.dirname(os.path.abspath(__file__))
    run_file = os.path.join(v2_root, "runs", run_id, "run.yml")
    if not os.path.exists(run_file):
        print(f"Error: Run ID '{run_id}' not found.", file=sys.stderr)
        sys.exit(1)

    run_data = read_yaml(run_file)
    if not run_data:
        print(f"Error: Failed to load run data.", file=sys.stderr)
        sys.exit(1)

    if run_data.get("is_legacy", False):
        print(f"Error: Cannot update status of legacy/incompatible run '{run_id}'.", file=sys.stderr)
        sys.exit(1)

    current_status = run_data.get("status", "").lower()
    t_status = target_status.lower()

    allowed = False
    if t_status == "paused":
        if current_status in ["created", "active"]:
            allowed = True
    elif t_status == "active":
        if current_status == "paused":
            allowed = True
    elif t_status == "failed":
        if current_status in ["created", "active", "paused"]:
            allowed = True
    elif t_status == "cancelled":
        if current_status in ["created", "active", "paused"]:
            allowed = True

    if not allowed:
        print(f"Error: Invalid status transition from '{current_status}' to '{t_status}'.", file=sys.stderr)
        sys.exit(1)

    run_data["status"] = t_status
    write_yaml(run_file, run_data)
    print(f"Success: Run '{run_id}' status updated from '{current_status}' to '{t_status}'.")

# Custom HTTP Request Handler for serving dashboard and REST APIs
class DashboardHTTPRequestHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def do_GET(self):
        v2_root = os.path.dirname(os.path.abspath(__file__))

        # REST API: Fetch all Runs
        if self.path == "/api/runs":
            runs_dir = os.path.join(v2_root, "runs")
            runs_list = []
            if os.path.exists(runs_dir):
                for run_id in os.listdir(runs_dir):
                    run_file = os.path.join(runs_dir, run_id, "run.yml")
                    if os.path.exists(run_file):
                        run_data = read_yaml(run_file)
                        if run_data:
                            runs_list.append(run_data)

            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            self.wfile.write(json.dumps(runs_list, ensure_ascii=False).encode('utf-8'))
            return

        # REST API: Milestone Road Map Status
        if self.path == "/api/milestones":
            try:
                milestones = read_milestones(v2_root)
            except (OSError, json.JSONDecodeError) as exc:
                self.send_response(500)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.end_headers()
                self.wfile.write(json.dumps({"error": f"Core milestone state unavailable: {exc}"}, ensure_ascii=False).encode('utf-8'))
                return
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            self.wfile.write(json.dumps(milestones, ensure_ascii=False).encode('utf-8'))
            return

        # Serve static html page
        if self.path == "/" or self.path == "/index.html":
            html_path = os.path.join(v2_root, "dashboard.html")
            if os.path.exists(html_path):
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()
                with open(html_path, 'r', encoding='utf-8') as f:
                    self.wfile.write(f.read().encode('utf-8'))
                return

        self.send_response(404)
        self.end_headers()

def cmd_dashboard(args):
    port = args.port
    server_address = ('127.0.0.1', port)
    httpd = HTTPServer(server_address, DashboardHTTPRequestHandler)
    print(f"AI OS V2 Dashboard starting at http://127.0.0.1:{port} ...")
    print("Press Ctrl+C to stop.")

    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nStopping dashboard server.")
        httpd.server_close()

def main():
    parser = argparse.ArgumentParser(description="AI OS V2 Core Command Line Interface")
    subparsers = parser.add_subparsers(dest="command", required=True)

    run_parser = subparsers.add_parser("run", help="Manage V2 runs")
    run_subparsers = run_parser.add_subparsers(dest="run_command", required=True)

    # v2 run create
    create_parser = run_subparsers.add_parser("create", help="Create a new run")
    create_parser.add_argument("--project", required=True, help="Path to the target project directory")
    create_parser.add_argument("--spec", required=True, help="Natural language request/spec description")
    create_parser.add_argument("--type", choices=["feature", "change"], default="feature", help="Type of run")

    # v2 run show
    show_parser = run_subparsers.add_parser("show", help="Show details of a run")
    show_parser.add_argument("run_id", help="The Run ID to inspect")

    # v2 run pause
    pause_parser = run_subparsers.add_parser("pause", help="Pause a run")
    pause_parser.add_argument("run_id", help="The Run ID to pause")

    # v2 run resume
    resume_parser = run_subparsers.add_parser("resume", help="Resume a paused run")
    resume_parser.add_argument("run_id", help="The Run ID to resume")

    # v2 run fail
    fail_parser = run_subparsers.add_parser("fail", help="Mark a run as failed")
    fail_parser.add_argument("run_id", help="The Run ID to mark as failed")

    # v2 run cancel
    cancel_parser = run_subparsers.add_parser("cancel", help="Cancel a run")
    cancel_parser.add_argument("run_id", help="The Run ID to cancel")

    # spec management
    spec_parser = subparsers.add_parser("spec", help="Manage spec verification and gates")
    spec_subparsers = spec_parser.add_subparsers(dest="spec_command", required=True)

    spec_show_parser = spec_subparsers.add_parser("show", help="Show the current specification details")
    spec_show_parser.add_argument("run_id", help="The Run ID to inspect")

    spec_modify_parser = spec_subparsers.add_parser("modify", help="Request modifications to the specification")
    spec_modify_parser.add_argument("run_id", help="The Run ID to modify")
    spec_modify_parser.add_argument("--comment", required=True, help="Feedback or requested changes for the spec")

    spec_approve_parser = spec_subparsers.add_parser("approve", help="Approve the current specification and proceed")
    spec_approve_parser.add_argument("run_id", help="The Run ID to approve")

    spec_reject_parser = spec_subparsers.add_parser("reject", help="Reject the specification and cancel the run")
    spec_reject_parser.add_argument("run_id", help="The Run ID to reject")

    # plan command
    plan_parser = subparsers.add_parser("plan", help="Start plan phase for an approved specification")
    plan_parser.add_argument("run_id", help="The Run ID to plan")

    # v2 dashboard
    dashboard_parser = subparsers.add_parser("dashboard", help="Start dashboard local web server")
    dashboard_parser.add_argument("--port", type=int, default=8200, help="Local server port (default: 8200)")

    args = parser.parse_args()

    if args.command == "run":
        if args.run_command == "create":
            cmd_create(args)
        elif args.run_command == "show":
            cmd_show(args)
        elif args.run_command == "pause":
            update_run_status(args.run_id, "paused")
        elif args.run_command == "resume":
            update_run_status(args.run_id, "active")
        elif args.run_command == "fail":
            update_run_status(args.run_id, "failed")
        elif args.run_command == "cancel":
            update_run_status(args.run_id, "cancelled")
    elif args.command == "spec":
        if args.spec_command == "show":
            cmd_spec_show(args)
        elif args.spec_command == "modify":
            cmd_spec_modify(args)
        elif args.spec_command == "approve":
            cmd_spec_approve(args)
        elif args.spec_command == "reject":
            cmd_spec_reject(args)
    elif args.command == "plan":
        cmd_plan(args)
    elif args.command == "dashboard":
        cmd_dashboard(args)

if __name__ == "__main__":
    main()
