# Helper to run shell commands
def run_cmd(cmd, cwd=None):
    try:
        argv = shlex.split(cmd) if isinstance(cmd, str) else cmd
        res = subprocess.run(argv, shell=False, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, cwd=cwd)
        return res.returncode, res.stdout.strip(), res.stderr.strip()
    except Exception as e:
        return -1, "", str(e)

# Helper to parse simple yaml/json-inline format with legacy validation
def read_yaml(filepath):
    if not os.path.exists(filepath):
        return None
    data = {}
    with open(filepath, 'r', encoding='utf-8') as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith('#'):
                continue
            if ':' in line:
                key, val_str = line.split(':', 1)
                key = key.strip()
                val_str = val_str.strip()
                try:
                    val = json.loads(val_str)
                except Exception:
                    val = val_str.strip('"').strip("'")
                data[key] = val

    # Validate legacy run format for M1.1 schema
    if "run_id" in data:
        if "memory" not in data or "project" not in data:
            data["is_legacy"] = True
        else:
            data["is_legacy"] = False

    return data

# Helper to write simple yaml
def write_yaml(filepath, data):
    os.makedirs(os.path.dirname(filepath), exist_ok=True)
    with open(filepath, 'w', encoding='utf-8') as f:
        for k, v in data.items():
            v_str = json.dumps(v, ensure_ascii=False)
            f.write(f"{k}: {v_str}\n")


def file_sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as source_file:
        for chunk in iter(lambda: source_file.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def inspect_design_image(path):
    """Validate a passive raster design input without decoding or executing it."""
    if not os.path.isfile(path):
        raise ValueError(f"Design image does not exist: {path}")
    if os.path.islink(path):
        raise ValueError(f"Symbolic-link design inputs are not allowed: {path}")
    size = os.path.getsize(path)
    if size <= 0:
        raise ValueError(f"Design image is empty: {path}")
    with open(path, "rb") as image_file:
        payload = image_file.read()

    mime = None
    width = height = None
    extension = None
    if payload.startswith(b"\x89PNG\r\n\x1a\n") and len(payload) >= 24:
        mime, extension = "image/png", ".png"
        width, height = struct.unpack(">II", payload[16:24])
    elif payload.startswith(b"\xff\xd8"):
        mime, extension = "image/jpeg", ".jpg"
        offset = 2
        while offset + 9 < len(payload):
            if payload[offset] != 0xFF:
                offset += 1
                continue
            marker = payload[offset + 1]
            offset += 2
            if marker in {0xD8, 0xD9}:
                continue
            if offset + 2 > len(payload):
                break
            segment_length = struct.unpack(">H", payload[offset:offset + 2])[0]
            if marker in {0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF}:
                if offset + 7 > len(payload):
                    break
                height, width = struct.unpack(">HH", payload[offset + 3:offset + 7])
                break
            if segment_length < 2:
                break
            offset += segment_length
    elif payload.startswith(b"RIFF") and payload[8:12] == b"WEBP" and len(payload) >= 30:
        mime, extension = "image/webp", ".webp"
        chunk = payload[12:16]
        if chunk == b"VP8X":
            width = 1 + int.from_bytes(payload[24:27], "little")
            height = 1 + int.from_bytes(payload[27:30], "little")

    if not mime or not width or not height or width <= 0 or height <= 0:
        raise ValueError(f"Unsupported or malformed design image: {path}")
    return {
        "source_path": os.path.abspath(path),
        "sha256": file_sha256(path),
        "mime": mime,
        "width": width,
        "height": height,
        "bytes": size,
        "extension": extension,
    }


