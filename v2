    create_parser.add_argument(
        "--target-area",
        help="Stable UI area label for an explicit quick Change Run",
    )

    # v2 run show
    show_parser = run_subparsers.add_parser("show", help="Show details of a run")
    show_parser.add_argument("run_id", help="The Run ID to inspect")

    # v2 run pause
    pause_parser = run_subparsers.add_parser("pause", help="Pause a run")
    pause_parser.add_argument("run_id", help="The Run ID to pause")

    # v2 run resume
    resume_parser = run_subparsers.add_parser("resume", help="Resume a paused run")
    resume_parser.add_argument("run_id", help="The Run ID to resume")

    # v2 run fail
    fail_parser = run_subparsers.add_parser("fail", help="Mark a run as failed")
    fail_parser.add_argument("run_id", help="The Run ID to mark as failed")

    # v2 run cancel
    cancel_parser = run_subparsers.add_parser("cancel", help="Cancel a run")
    cancel_parser.add_argument("run_id", help="The Run ID to cancel")

    # spec management
    spec_parser = subparsers.add_parser("spec", help="Manage spec verification and gates")
    spec_subparsers = spec_parser.add_subparsers(dest="spec_command", required=True)

    spec_show_parser = spec_subparsers.add_parser("show", help="Show the current specification details")
    spec_show_parser.add_argument("run_id", help="The Run ID to inspect")

    spec_modify_parser = spec_subparsers.add_parser("modify", help="Request modifications to the specification")
    spec_modify_parser.add_argument("run_id", help="The Run ID to modify")
    spec_modify_parser.add_argument("--comment", required=True, help="Feedback or requested changes for the spec")

    spec_approve_parser = spec_subparsers.add_parser("approve", help="Approve the current specification and proceed")
    spec_approve_parser.add_argument("run_id", help="The Run ID to approve")

    spec_reject_parser = spec_subparsers.add_parser("reject", help="Reject the specification and cancel the run")
    spec_reject_parser.add_argument("run_id", help="The Run ID to reject")

    # plan command
    plan_parser = subparsers.add_parser("plan", help="Start plan phase for an approved specification")
    plan_parser.add_argument("run_id", help="The Run ID to plan")

    design_parser = subparsers.add_parser("design", help="Generate, inspect, or approve M3 design Artifacts")
    design_subparsers = design_parser.add_subparsers(dest="design_command", required=True)
    design_generate_parser = design_subparsers.add_parser("generate", help="Generate a versioned A/B Preview")
    design_generate_parser.add_argument("run_id", help="The existing Run ID")
