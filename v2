            os.close(lock_fd)
        except FileExistsError as exc:
            raise RuntimeError("Another design task is already running for this Run.") from exc

        current_design = run_data.get("design", {})
        if current_design.get("status") in {"design_in_progress", "awaiting_design_review", "approved"}:
            raise ValueError(f"Design generation is blocked by current status '{current_design.get('status')}'.")

        version = int(current_design.get("version") or 0) + 1
