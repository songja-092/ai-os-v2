        run_data["collection_analysis"]["codex_call_count"] = 1
        write_codex_task_log(log_path, result)
        after_project = get_git_changed_paths(project_path)
        after_v2 = get_git_changed_paths(v2_root)
        project_new = sorted(after_project - before_project)
        v2_new = sorted(after_v2 - before_v2)
        unexpected_v2 = [
            path for path in v2_new
            if not is_allowed_skill_change(path, [os.path.relpath(run_dir, v2_root)])
        ]
        if result["returncode"] != 0:
            raise RuntimeError(f"Codex collection-analysis exited with {result['returncode']}.")
        if project_new or unexpected_v2:
            raise RuntimeError(
                f"Files changed outside the allowed Run directory: project={project_new}, v2={unexpected_v2}"
            )
        if source_type:
            allowed_temp_files = {
                "request.md", "source-input.md", "project-context.md", "v2-context.md",
