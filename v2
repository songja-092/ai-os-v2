def validate_pm2_board_state(state, manifests):
    if state.get("project_id") != PM2_PROJECT_ID or state.get("active_slot") != "workspace_preview":
        raise ValueError("PM2 board state belongs to an unsupported project or Slot.")
    modules = state.get("modules")
    if not isinstance(modules, list) or len(modules) != 2:
        raise ValueError("PM2 board state must contain exactly two verified Module candidates.")
    seen = set()
    for item in modules:
        module_id = item.get("module_id")
        if module_id in seen or module_id not in manifests:
            raise ValueError(f"Unregistered or duplicate Module: {module_id}")
        if not isinstance(item.get("enabled"), bool) or not isinstance(item.get("failed"), bool):
            raise ValueError(f"Invalid Module state: {module_id}")
        seen.add(module_id)
    modules.sort(key=lambda item: item.get("order", 0))
    for index, item in enumerate(modules, start=1):
        item["order"] = index
    active_module_id = state.get("active_module_id")
    if active_module_id not in seen:
        state["active_module_id"] = modules[0]["module_id"]
    return state


