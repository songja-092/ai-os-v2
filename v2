        references_path = require_path_within(references_path, [project_path], "Reference Manifest")
        evidence_path, evidence = load_json_object(args.tool_evidence, "Tool Evidence")
        evidence_path = require_path_within(evidence_path, [project_path], "Tool Evidence")
        source_reference_ids = references.get("source_reference_ids")
        if not isinstance(source_reference_ids, list) or not source_reference_ids:
            raise ValueError("Reference Manifest requires at least one source_reference_id.")
        generation_tool = evidence.get("generation_tool")
        if not generation_tool:
            raise ValueError("Tool Evidence requires generation_tool.")
        target_dir = os.path.dirname(visual_target_manifest_path(run_data, target_id))
        if os.path.exists(target_dir):
            raise FileExistsError(f"Visual Target ID already exists: {target_id}")
        lock_fd = os.open(lock_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
        lock_acquired = True
        os.write(lock_fd, str(os.getpid()).encode("ascii"))
        os.close(lock_fd)
        os.makedirs(os.path.dirname(target_dir), exist_ok=True)
        temp_dir = tempfile.mkdtemp(prefix=f".{target_id.lower()}-", dir=os.path.dirname(target_dir))
        inspected = inspect_design_image(source_path)
        copied_path = os.path.join(temp_dir, "visual-target" + inspected["extension"])
        shutil.copyfile(source_path, copied_path)
        copied = inspect_design_image(copied_path)
        if copied["sha256"] != inspected["sha256"]:
            raise RuntimeError("Visual Target copy verification failed.")
        manifest = {
            "schema_version": 1,
            "id": target_id,
            "run_id": args.run_id,
            "direction_id": direction_id,
            "screen_id": screen_id,
            "viewport": args.viewport,
            "artifact_path": copied_path.replace(temp_dir, target_dir, 1),
            "sha256": copied["sha256"],
            "mime_type": copied["mime"],
            "width": copied["width"],
            "height": copied["height"],
            "origin": "generated_inside_run",
            "generated_inside_run": True,
            "generation_tool": generation_tool,
            "prompt_path": prompt_path,
            "prompt_sha256": file_sha256(prompt_path),
            "source_reference_ids": source_reference_ids,
            "references_manifest_path": references_path,
            "tool_execution_evidence_path": evidence_path,
            "status": "awaiting_user_review",
            "created_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        }
        with open(os.path.join(temp_dir, "manifest.json"), "w", encoding="utf-8") as handle:
            json.dump(manifest, handle, ensure_ascii=False, indent=2)
            handle.write("\n")
        os.rename(temp_dir, target_dir)
        temp_dir = None
        validate_visual_target_manifest(manifest, run_data, os.path.join(target_dir, "manifest.json"))
        targets = run_data.get("visual_targets", {"status": "awaiting_user_review", "items": []})
        targets.setdefault("items", []).append({"id": target_id, "manifest_path": os.path.join(target_dir, "manifest.json"), "status": "awaiting_user_review"})
        targets["status"] = "awaiting_user_review"
        run_data["visual_targets"] = targets
        run_data["implementation_gate"] = "blocked_user_visual_approval_required"
        write_yaml(run_file, run_data)
        print(f"Visual Target registered: {target_id}")
        print("Status: awaiting_user_review")
    except Exception as exc:
        if temp_dir and os.path.isdir(temp_dir):
            shutil.rmtree(temp_dir)
        print(f"Error: Visual Target registration failed: {exc}", file=sys.stderr)
        sys.exit(1)
    finally:
        if lock_acquired and os.path.exists(lock_path):
            os.unlink(lock_path)


def find_visual_target(run_data, target_id):
    target_id = validate_design_identifier(target_id, "Visual Target ID")
    for item in run_data.get("visual_targets", {}).get("items", []):
