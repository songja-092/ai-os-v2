            "version": version,
            "status": "design_in_progress",
            "skill_name": "ui-ux-pro-max",
            "skill_version": "2.14.1",
            "renderer_skill": "build-web-apps:frontend-app-builder",
            "verification_skill": "build-web-apps:frontend-testing-debugging",
            "artifact_path": artifact_dir,
            "preview_url": None,
            "selected_option": None,
            "user_result": "pending",
            "primary_viewport": "mobile",
            "started_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "logs": {},
