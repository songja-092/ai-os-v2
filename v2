def run_codex_task(cwd, prompt, timeout, skip_git_repo_check=False):
    """Run one non-interactive Codex task without introducing another orchestrator."""
    if not prompt.strip():
        raise ValueError("Codex task prompt is empty.")
    cmd = build_codex_exec_command(prompt, skip_git_repo_check=skip_git_repo_check)
    env = os.environ.copy()
    env.pop("SPECKIT_INTEGRATION_CODEX_EXTRA_ARGS", None)
    try:
        result = subprocess.run(
            cmd,
            shell=False,
            cwd=cwd,
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired as exc:
        raise TimeoutError(f"Codex task timed out after {timeout} seconds.") from exc
    return {
        "command": [*cmd[:-1], "<structured collection-analysis prompt>"],
        "returncode": result.returncode,
        "stdout": result.stdout,
        "stderr": result.stderr,
    }


