def validate_visual_target_manifest(manifest, run_data, manifest_path):
    required = {
        "schema_version", "id", "run_id", "direction_id", "screen_id", "viewport",
        "artifact_path", "sha256", "mime_type", "width", "height", "origin",
        "generated_inside_run", "generation_tool", "prompt_path", "prompt_sha256",
        "source_reference_ids", "references_manifest_path", "tool_execution_evidence_path",
        "status", "created_at",
    }
    missing = required - set(manifest)
    if missing:
        raise ValueError(f"Visual Target manifest missing fields: {sorted(missing)}")
    if manifest["run_id"] != run_data.get("run_id"):
        raise ValueError("Visual Target Run mismatch.")
    if manifest["direction_id"] != run_data.get("design_direction", {}).get("id"):
        raise ValueError("Visual Target direction mismatch.")
    if manifest["origin"] != "generated_inside_run" or manifest["generated_inside_run"] is not True:
        raise ValueError("Visual Target origin truth is invalid.")
    project_path = run_data.get("project", {}).get("path")
    artifact_path = require_path_within(manifest["artifact_path"], [project_path], "Visual Target")
    inspected = inspect_design_image(artifact_path)
    if inspected["sha256"] != manifest["sha256"] or inspected["mime"] != manifest["mime_type"]:
        raise ValueError("Visual Target image identity mismatch.")
    if inspected["width"] != manifest["width"] or inspected["height"] != manifest["height"]:
        raise ValueError("Visual Target dimensions mismatch.")
    prompt_path = require_path_within(manifest["prompt_path"], [project_path], "Prompt")
    if file_sha256(prompt_path) != manifest["prompt_sha256"]:
        raise ValueError("Prompt checksum mismatch.")
    references_path, references = load_json_object(manifest["references_manifest_path"], "Reference Manifest")
    require_path_within(references_path, [project_path], "Reference Manifest")
    reference_ids = references.get("source_reference_ids")
    if not isinstance(reference_ids, list) or not reference_ids or reference_ids != manifest["source_reference_ids"]:
        raise ValueError("Visual Target requires matching source Reference IDs.")
    evidence_path, evidence = load_json_object(manifest["tool_execution_evidence_path"], "Tool Evidence")
    require_path_within(evidence_path, [project_path], "Tool Evidence")
    if not evidence.get("generation_tool"):
        raise ValueError("Tool Evidence requires generation_tool.")
    if evidence["generation_tool"] != manifest["generation_tool"]:
        raise ValueError("Generation tool evidence mismatch.")
    return True


def cmd_visual_target_register(args):
    run_file = get_run_file(args.run_id)
    if not os.path.isfile(run_file):
        print(f"Error: Run '{args.run_id}' not found.", file=sys.stderr)
