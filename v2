        })
        run_data["collection_analysis"]["validation"] = {
            "status": "PASS",
            "profile": run_data["collection_analysis"]["analysis_kind"],
            "errors": [],
        }
        write_yaml(run_file, run_data)
    except Exception as exc:
        run_data["status"] = "failed"
        run_data["next_stage_allowed"] = False
        run_data["preview_gate"] = "blocked_collection_analysis_failed"
        run_data["failure_reason"] = str(exc)
        run_data["collection_analysis"]["status"] = "failed"
        run_data["collection_analysis"]["validation"] = {
            "status": "failed",
            "profile": run_data["collection_analysis"].get("analysis_kind"),
            "errors": [str(exc)],
        }
        write_yaml(run_file, run_data)
        print(f"Error: Collection-analysis failed: {exc}", file=sys.stderr)
        print(f"Run ID: {run_id}", file=sys.stderr)
        print(f"Log: {log_path}", file=sys.stderr)
        sys.exit(1)
    finally:
        if isolation is not None:
            isolation.cleanup()

    print(f"AI OS V2 Collection Analysis Run: {run_id}")
    print("Status: awaiting_user_review")
    print(f"Selected Recipe: {selected_recipe}")
    print(f"Next Action: {next_action}")
    print(f"User Summary: {paths['user_summary']}")

def cmd_create(args):
    project_path = os.path.abspath(args.project)
    if args.execution_path == "quick" and args.type != "change":
        print("Error: quick execution is supported only for --type change.", file=sys.stderr)
        sys.exit(1)
    is_quick_change = args.type == "change" and args.execution_path == "quick"

    # 1. Active Run Check (Limit to 1 active run at a time)
    active_run = get_active_run()
    if active_run:
        print(f"Error: Active Run already exists. Cannot create a new one.", file=sys.stderr)
        print(f"Existing Run ID: {active_run.get('run_id')}", file=sys.stderr)
        print(f"Current Status: {active_run.get('status')}", file=sys.stderr)
        sys.exit(1)

    # 2. Git Safety check
    success, msg = check_git_safety(project_path)
    if not success:
        print(f"Error: Git Safety Check Failed.\nReason: {msg}", file=sys.stderr)
        sys.exit(1)

    # 3. Retrieve commits and branches
    v2_root = os.path.dirname(os.path.abspath(__file__))
    base_memory_commit_official = get_origin_main_commit(v2_root)
    base_memory_commit_local = get_git_commit(v2_root)

    v2_workspace_branch = get_git_branch(v2_root)
    project_branch = get_git_branch(project_path)
    base_project_commit = get_git_commit(project_path)

    if not base_memory_commit_official:
        print("Error: Failed to resolve Base Memory Commit (origin/main HEAD).", file=sys.stderr)
        sys.exit(1)

    quick_references = None
    if is_quick_change:
        if not args.target_area:
            print("Error: --target-area is required for a quick Change Run.", file=sys.stderr)
            sys.exit(1)
        quick_references = existing_change_artifacts(project_path)
        required_references = {"spec", "plan", "tasks", "design_preview"}
        missing_references = sorted(required_references - set(quick_references))
        if missing_references:
            print(
                f"Error: Required existing artifacts are missing: {missing_references}",
                file=sys.stderr,
            )
            sys.exit(1)

    # 4. Generate unique Run ID (8-char hex UUID)
    run_id = f"run-{uuid.uuid4().hex[:8]}"

    # 하나의 사용자 명령은 V2 Run 하나만 만든다.
    run_dir_path = os.path.join(v2_root, "runs", run_id)
    os.makedirs(run_dir_path, exist_ok=True)
    run_file = os.path.join(run_dir_path, "run.yml")
    log_file_path = os.path.join(run_dir_path, "skill-speckit-specify.log")

    run_data = {
        "run_id": run_id,
        "run_type": args.type,
        "request": args.spec,
        "stage": "change_ready" if is_quick_change else "intake",
        "status": "active",
        "created_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "git_safety_at_creation": "PASS",
        "requirements_version": 1,
        "requirements_status": "not_applicable" if is_quick_change else "generating",
        "requirements_artifact": None,
        "requirements_checklist": None,
        "execution_path": "quick" if is_quick_change else "standard",
        "approval": {"status": "pending", "approved_version": None, "approved_at": None},
        "next_stage_allowed": False,
        "memory": {"official_branch": "main", "official_commit": base_memory_commit_official},
