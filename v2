        print(f"Error: Run '{args.run_id}' not found.", file=sys.stderr)
        sys.exit(1)

    run_data = read_yaml(run_file)
    req_status = run_data.get("requirements_status")
    approval_info = run_data.get("approval", {})
    app_status = approval_info.get("status")
    app_version = approval_info.get("approved_version")
    req_version = run_data.get("requirements_version")

    if run_data.get("status") in ["cancelled", "failed"] or req_status == "rejected":
        print("Error: Cannot start planning on a cancelled, failed, or rejected run.", file=sys.stderr)
        sys.exit(1)

    project_path = run_data.get("project", {}).get("path")
    recorded_spec_path = run_data.get("requirements_artifact")
    feature_dir, actual_spec_path, _ = resolve_feature_artifacts(project_path)

    next_allowed = (req_status == "approved" and
                    app_status == "approved" and
                    app_version == req_version)

    if not next_allowed:
        print("Error: Specification not approved or version mismatch.", file=sys.stderr)
        print(f"  Requirements Status: {req_status}", file=sys.stderr)
        print(f"  Approved Version: {app_version} (Current: {req_version})", file=sys.stderr)
        sys.exit(1)

    if (
        not recorded_spec_path
        or os.path.realpath(recorded_spec_path) != os.path.realpath(actual_spec_path or "")
        or not os.path.isfile(recorded_spec_path)
        or os.path.getsize(recorded_spec_path) == 0
    ):
        print("Error: Approved specification Artifact is missing or does not match the Run.", file=sys.stderr)
        sys.exit(1)

    print(f"Plan 단계 진입 허용 (Run ID: {args.run_id})")
    print(f"동일 V2 Run ID: {args.run_id}")
    print(f"승인된 Requirements Version: {req_version}")

    run_dir_path = os.path.dirname(run_file)
    log_file_path = os.path.join(run_dir_path, "skill-speckit-plan.log")
    try:
        non_interactive_guard = (
            "\n\n[IMPORTANT: You are running in an automated non-interactive batch environment. "
            "Do NOT ask any clarification questions. "
            "Resolve any ambiguities by making reasonable assumptions. "
            "Produce the final plan.md file immediately and exit successfully.]"
        )
        plan_prompt = "Create the technical plan for the currently active approved specification." + non_interactive_guard
        skill_result = run_skill(
            project_path,
            "speckit-plan",
            plan_prompt,
            600,
            [feature_dir, ".specify/feature.json"],
        )
    except Exception as e:
        run_data["status"] = "failed"
        run_data["failure_reason"] = str(e)
        write_yaml(run_file, run_data)
        print(f"Error executing speckit-plan: {e}", file=sys.stderr)
        sys.exit(1)

    write_skill_log(log_file_path, "speckit-plan", skill_result)
    plan_path = os.path.join(project_path, feature_dir, "plan.md")
    has_plan = os.path.isfile(plan_path) and os.path.getsize(plan_path) > 0

    if skill_result["returncode"] != 0 or skill_result["unexpected_changes"] or not has_plan:
        run_data["status"] = "failed"
        run_data["failure_reason"] = "Plan Skill execution or Artifact validation failed."
        write_yaml(run_file, run_data)
        print("Error: Technical Plan generation failed.", file=sys.stderr)
        print(f"Exit Code: {skill_result['returncode']}", file=sys.stderr)
        print(f"Log: {log_file_path}", file=sys.stderr)
        sys.exit(1)

    run_data["planning_artifact"] = plan_path
    run_data["stage"] = "planning"
    run_data["status"] = "active"
    write_yaml(run_file, run_data)

    print(f"Success: Technical Plan generated successfully at {plan_path}")


def get_run_file(run_id):
    v2_root = os.path.dirname(os.path.abspath(__file__))
    return os.path.join(v2_root, "runs", run_id, "run.yml")


def require_design_prerequisites(run_id):
    run_file = get_run_file(run_id)
    if not os.path.isfile(run_file):
        raise ValueError(f"Run '{run_id}' not found.")
    run_data = read_yaml(run_file)
    if run_data.get("is_legacy"):
        raise ValueError("Legacy Run cannot enter the design stage.")
    if run_data.get("status") in {"failed", "rejected", "cancelled"}:
        raise ValueError(f"Run status '{run_data.get('status')}' blocks design generation.")
    approval = run_data.get("approval", {})
    if (
        run_data.get("requirements_status") != "approved"
        or approval.get("status") != "approved"
        or approval.get("approved_version") != run_data.get("requirements_version")
    ):
        raise ValueError("The current specification Version is not approved.")
    spec_path = run_data.get("requirements_artifact")
    plan_path = run_data.get("planning_artifact")
    for label, path in (("spec.md", spec_path), ("plan.md", plan_path)):
        if not path or not os.path.isfile(path) or os.path.getsize(path) == 0:
            raise ValueError(f"Required Artifact '{label}' is missing or empty.")
    project_path = run_data.get("project", {}).get("path")
    if not project_path or not os.path.isdir(project_path):
        raise ValueError("Run project path is unavailable.")
    skill_file, _ = resolve_skill("ui-ux-pro-max", project_path)
    if not skill_file:
        raise ValueError("UI UX Pro Max is not installed.")
    return run_file, run_data, project_path, spec_path, plan_path, skill_file


def run_ui_ux_pro_max(skill_file, artifact_dir, log_path):
    search_script = os.path.join(os.path.dirname(skill_file), "scripts", "search.py")
    if not os.path.isfile(search_script):
        raise ValueError(f"UI UX Pro Max search tool is missing: {search_script}")
    queries = [
        ("A", "community hospital healthcare warm reassuring human-centered spacious"),
        ("B", "hospital healthcare professional clinical information-dense efficient"),
    ]
    outputs = []
    log_parts = []
    for option, query in queries:
        command = [
            sys.executable,
            search_script,
            query,
            "--design-system",
            "-f",
            "markdown",
            "-p",
            f"Hospital Preview {option}",
        ]
        result = subprocess.run(
            command,
            shell=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=120,
        )
        log_parts.append(
            f"Option: {option}\nCommand: {json.dumps(command, ensure_ascii=False)}\n"
            f"Exit Code: {result.returncode}\n--- Stdout ---\n{result.stdout}\n"
            f"--- Stderr ---\n{result.stderr}\n"
        )
        if result.returncode != 0 or not result.stdout.strip():
            with open(log_path, "w", encoding="utf-8") as log_file:
                log_file.write("\n".join(log_parts))
            raise RuntimeError(f"UI UX Pro Max failed for option {option}.")
        outputs.append(f"# Option {option}\n\n{result.stdout.strip()}\n")
    os.makedirs(artifact_dir, exist_ok=False)
    with open(os.path.join(artifact_dir, "design-system.md"), "w", encoding="utf-8") as output_file:
        output_file.write("# UI UX Pro Max Design Directions\n\n")
        output_file.write("\n\n".join(outputs))
    with open(log_path, "w", encoding="utf-8") as log_file:
        log_file.write("\n".join(log_parts))


def ensure_preview_server(project_path, run_dir):
    host, port = "127.0.0.1", 4173
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        already_running = sock.connect_ex((host, port)) == 0
    finally:
        sock.close()
    if not already_running:
        server_log_path = os.path.join(run_dir, "design-preview-server.log")
        server_log = open(server_log_path, "a", encoding="utf-8")
        subprocess.Popen(
            [sys.executable, "-m", "http.server", str(port), "--bind", host, "--directory", "design-preview"],
            cwd=project_path,
            stdin=subprocess.DEVNULL,
            stdout=server_log,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    return f"http://{host}:{port}"


def cmd_design_generate(args):
    lock_path = None
    run_file = None
    run_data = None
