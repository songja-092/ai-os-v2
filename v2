def validate_analysis_artifact(analysis_path, analysis_kind):
    if not os.path.isfile(analysis_path) or os.path.getsize(analysis_path) == 0:
        raise ValueError("analysis.md is missing or empty.")
    with open(analysis_path, "r", encoding="utf-8") as analysis_file:
        analysis = analysis_file.read()
    if "## 후보 3" in analysis:
        raise ValueError("analysis.md contains more than two candidates.")

    profiles = {
        "natural_request": [
            ("실제 목표",), ("가능 여부",), ("후보 1",), ("최종 추천",),
            ("포함 범위",), ("제외 범위",), ("위험", "보안", "제한"),
            ("Preview", "검증"), ("완료 수준",), ("next_action:",),
        ],
        "user_provided_source": [
            ("확인 목적",), ("실제 접근 범위", "확인한 범위"),
            ("확인하지 못한 범위", "미확인"), ("자료에서 발견한 주장",),
            ("공식 출처에서 확인된 사실",), ("현재 V2와 중복", "중복 여부"),
            ("최종 판정",), ("판정 이유", "이유"),
            ("V2 적용 위치", "재검토 조건", "도입 시점"), ("next_action:",),
        ],
    }
    if analysis_kind not in profiles:
        raise ValueError(f"Unknown analysis validation profile: {analysis_kind}")
    missing = [
        "/".join(alternatives)
        for alternatives in profiles[analysis_kind]
        if not any(term in analysis for term in alternatives)
    ]
    if missing:
        raise ValueError(
            f"analysis.md failed profile '{analysis_kind}'; missing: {', '.join(missing)}"
        )
    return analysis


def validate_collection_analysis_artifacts(run_dir):
    paths = {
        "research": os.path.join(run_dir, "research.md"),
        "analysis": os.path.join(run_dir, "analysis.md"),
        "user_summary": os.path.join(run_dir, "user-summary.md"),
    }
    for label, path in paths.items():
        if not os.path.isfile(path) or os.path.getsize(path) == 0:
            raise ValueError(f"Required {label} Artifact is missing or empty.")

    with open(paths["research"], "r", encoding="utf-8") as research_file:
        research = research_file.read()
    analysis = validate_analysis_artifact(paths["analysis"], "natural_request")
    with open(paths["user_summary"], "r", encoding="utf-8") as summary_file:
        summary = summary_file.read()

    urls = sorted(set(re.findall(r"https?://[^\s)>\]]+", research)))
    if not urls:
        raise ValueError("research.md does not contain a source URL.")
    required_research = ["공식 자료", "GitHub", "성공·실패 사례", "확인 일자"]
    required_summary = ["요청", "가능 여부", "추천 방식", "포함", "제외", "위험", "다음 작업"]
    for label in required_research:
        if label not in research:
            raise ValueError(f"research.md is missing section: {label}")
    for label in required_summary:
        if label not in summary:
            raise ValueError(f"user-summary.md is missing section: {label}")

    selected_match = re.search(r"^selected_recipe:\s*([a-z0-9][a-z0-9_-]*)\s*$", analysis, re.MULTILINE)
    next_match = re.search(r"^next_action:\s*(preview|local_product)\s*$", analysis, re.MULTILINE)
    if not selected_match or not next_match:
        raise ValueError("analysis.md is missing selected_recipe or a valid next_action marker.")
    return paths, selected_match.group(1), next_match.group(1), urls


def classify_source(source_url=None, source_text=None, source_file=None):
    provided = [value is not None for value in (source_url, source_text, source_file)]
    if sum(provided) > 1:
        raise ValueError("Only one representative source may be provided per Run.")
    if source_url is not None:
        if not re.match(r"^https?://", source_url):
            raise ValueError("source_url must be a public HTTP or HTTPS URL.")
        if "youtube.com/" in source_url or "youtu.be/" in source_url:
            source_type = "youtube"
        elif "github.com/" in source_url:
            source_type = "github"
        else:
            source_type = "web"
        return source_type, source_url
    if source_text is not None:
        if not source_text.strip():
            raise ValueError("source_text is empty.")
        return "text", source_text
    if source_file is not None:
        path = os.path.abspath(source_file)
        if not os.path.isfile(path) or os.path.getsize(path) == 0:
            raise ValueError("source_file does not exist or is empty.")
        allowed_extensions = {
            ".md", ".txt", ".pdf", ".png", ".jpg", ".jpeg", ".webp",
            ".py", ".js", ".ts", ".tsx", ".jsx", ".json", ".yml", ".yaml", ".toml",
        }
        if os.path.splitext(path)[1].lower() not in allowed_extensions:
            raise ValueError("source_file type is not supported by the M5 MVP.")
        return "file", path
    return None, None


def write_source_input(path, source_type, source_value, request):
    if source_type == "text":
        limit = 12000
        stored_value = source_value[:limit]
        truncated = len(source_value) > limit
        source_display = stored_value
    else:
        truncated = False
        source_display = source_value
    collected_at = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    content = f"""# 사용자 제공 자료

## 확인 목적

{request}

## 자료 종류

{source_type}

## 사용자가 제공한 자료

{source_display}

## 원문 보존 범위

{'사용자 본문의 앞 12,000자만 보존함' if truncated else '사용자가 제공한 대표 자료 1개를 보존함'}

## 접근 결과

- 접근 성공 여부: pending
- 실제 읽은 범위: pending
- 자막 존재 여부: unknown
- 수집 시각: {collected_at}

access_status: pending
transcript_status: unknown
content_scope: unknown
"""
    with open(path, "w", encoding="utf-8") as source_file:
        source_file.write(content)


def validate_source_analysis_artifacts(source_root, artifact_root=None):
    artifact_root = artifact_root or source_root
    source_path = os.path.join(source_root, "source-input.md")
    if not os.path.isfile(source_path) or os.path.getsize(source_path) == 0:
        raise ValueError("source-input.md is missing or empty.")
    paths = {
        "research": os.path.join(artifact_root, "research.md"),
        "analysis": os.path.join(artifact_root, "analysis.md"),
        "user_summary": os.path.join(artifact_root, "user-summary.md"),
    }
    for label, path in paths.items():
        if not os.path.isfile(path) or os.path.getsize(path) == 0:
            raise ValueError(f"Required {label} Artifact is missing or empty.")
    source_text = open(source_path, "r", encoding="utf-8").read()
    research = open(paths["research"], "r", encoding="utf-8").read()
    analysis = validate_analysis_artifact(paths["analysis"], "user_provided_source")
    summary = open(paths["user_summary"], "r", encoding="utf-8").read()
    urls = sorted(set(re.findall(r"https?://[^\s)>\]]+", research)))
    for label in ["공식 자료", "GitHub", "성공·실패 사례", "확인 일자"]:
        if label not in research:
            raise ValueError(f"research.md is missing section: {label}")

    for label in ["제공 자료에서 발견한 주장", "공식 출처에서 실제 확인된 사실", "미확인"]:
        if label not in research:
            raise ValueError(f"research.md is missing source-analysis section: {label}")
    for label in ["자료 핵심 요약", "언급된 도구", "V2에서 비어 있는 역할", "예상 효과", "복잡도", "작은 파일럿"]:
        if label not in analysis:
            raise ValueError(f"analysis.md is missing source-analysis section: {label}")
    for label in ["확인한 범위", "확인하지 못한 범위", "공식 확인", "판정", "내가 할 일"]:
        if label not in summary:
            raise ValueError(f"user-summary.md is missing source-analysis section: {label}")
    recipe_match = re.search(r"^selected_recipe:\s*source-evaluation\s*$", analysis, re.MULTILINE)

    access_match = re.search(r"^access_status:\s*(accessible|partial|unavailable)\s*$", source_text, re.MULTILINE)
    transcript_match = re.search(
        r"^transcript_status:\s*(full|partial|unavailable|not_applicable|unknown)\s*$",
        source_text,
        re.MULTILINE,
    )
    scope_match = re.search(r"^content_scope:\s*([^\n]+)$", source_text, re.MULTILINE)
    disposition_match = re.search(
        r"^disposition:\s*(discarded|deferred|candidate|pilot_ready|needs_more_source)\s*$",
        analysis,
        re.MULTILINE,
    )
    verified_match = re.search(r"^official_sources_verified:\s*(true|false)\s*$", analysis, re.MULTILINE)
    next_match = re.search(
        r"^next_action:\s*(register_candidate|prepare_pilot|discard|defer|request_more_source)\s*$",
        analysis,
        re.MULTILINE,
    )
    if not all([recipe_match, access_match, transcript_match, scope_match, disposition_match, verified_match, next_match]):
        raise ValueError("Source-analysis machine-readable markers are missing or invalid.")
    disposition = disposition_match.group(1)
    official_verified = verified_match.group(1) == "true"
    if disposition in {"candidate", "pilot_ready"} and not official_verified:
        raise ValueError("candidate or pilot_ready requires official source verification.")
    if official_verified and len(urls) < 2:
        raise ValueError("Official cross-verification requires the provided URL plus an official source URL.")
    return {
        "source_path": source_path,
        "paths": paths,
        "access_status": access_match.group(1),
        "transcript_status": transcript_match.group(1),
        "content_scope": scope_match.group(1).strip(),
        "disposition": disposition,
        "official_sources_verified": official_verified,
        "next_action": next_match.group(1),
        "urls": urls,
    }


def build_isolated_analysis_context(temp_root, args, source_type, source_value, project_path):
    output_dir = os.path.join(temp_root, "output")
    os.makedirs(output_dir, exist_ok=False)
    request_path = os.path.join(temp_root, "request.md")
    source_path = os.path.join(temp_root, "source-input.md")
    project_context_path = os.path.join(temp_root, "project-context.md")
    v2_context_path = os.path.join(temp_root, "v2-context.md")

    with open(request_path, "w", encoding="utf-8") as request_file:
        request_file.write(
            "# 요청\n\n"
            f"{args.request}\n\n"
            "## 확인 목적\n\n사용자 제공 자료에서 V2에 적용할 수 있는 기능·도구·제작 방식을 판정합니다.\n\n"
            "## 결과\n\nresearch.md, analysis.md, user-summary.md를 생성합니다.\n"
        )
    write_source_input(source_path, source_type, source_value, args.request)

    package_path = os.path.join(project_path, "package.json")
    stack = "확인 가능한 package.json 없음"
    if os.path.isfile(package_path):
        try:
            package = json.load(open(package_path, "r", encoding="utf-8"))
            dependency_names = sorted(
                set(package.get("dependencies", {})) | set(package.get("devDependencies", {}))
            )
            stack = ", ".join(dependency_names) or "package.json에 직접 의존성 없음"
        except (OSError, json.JSONDecodeError):
            stack = "package.json 해석 실패"
    with open(project_context_path, "w", encoding="utf-8") as context_file:
        context_file.write(
            "# 최소 프로젝트 문맥\n\n"
            f"- 프로젝트 종류: Vite·TypeScript 기반 기존 병원 웹 파일럿\n"
            f"- 기준 Commit: {get_git_commit(project_path)}\n"
            f"- 확인된 기술 스택: {stack}\n"
            "- 기존 검증 레시피: 사용자 제공 영상·게시물 분석 레시피 없음\n"
            "- 설치된 관련 기능: Codex 웹 조사, Product Design, frontend-app-builder, UI UX Pro Max\n"
            "- 현재 마일스톤: M5 IN_PROGRESS\n"
            "- 금지 범위: 설치, 코드 실행, 제품 변경, Preview, 후보 자동 등록, M6\n"
        )
    with open(v2_context_path, "w", encoding="utf-8") as rules_file:
        rules_file.write(
            "# V2 Source Analysis 규칙\n\n"
            "- 제공 자료의 주장과 공식 확인 사실을 분리합니다.\n"
            "- 공식 저장소·문서·예제·Release·Issue를 우선합니다.\n"
            "- 후보는 최대 2개입니다.\n"
            "- 설치·실행·다운로드·로그인 우회를 하지 않습니다.\n"
            "- 접근하지 못한 내용을 추측하지 않습니다.\n"
            "- 접근 불가 시 needs_more_source는 정상 결과입니다.\n"
            "- output 안의 세 Artifact와 source-input.md만 수정합니다.\n"
        )
    return {
        "output_dir": output_dir,
        "request_path": request_path,
        "source_path": source_path,
        "project_context_path": project_context_path,
        "v2_context_path": v2_context_path,
    }


