def get_spec_path(project_path):
    if not project_path:
        return None
    feature_json_path = os.path.join(project_path, ".specify", "feature.json")
    if os.path.exists(feature_json_path):
        try:
            with open(feature_json_path, "r", encoding="utf-8") as fj:
                f_data = json.load(fj)
                feat_dir = f_data.get("feature_directory")
                if feat_dir:
                    return os.path.join(project_path, feat_dir, "spec.md")
        except Exception:
            pass
    return None

