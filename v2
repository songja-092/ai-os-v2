def load_json_file(path):
    with open(path, "r", encoding="utf-8") as source_file:
        return json.load(source_file)


def write_json_atomic(path, payload):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, temp_path = tempfile.mkstemp(prefix=".pm2-state-", suffix=".json", dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as target_file:
            json.dump(payload, target_file, ensure_ascii=False, indent=2)
            target_file.write("\n")
        os.replace(temp_path, path)
    finally:
        if os.path.exists(temp_path):
            os.unlink(temp_path)


def write_text_atomic(path, content):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, temp_path = tempfile.mkstemp(prefix=".v2-text-", suffix=".tmp", dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as target_file:
            target_file.write(content)
        os.replace(temp_path, path)
    finally:
        if os.path.exists(temp_path):
            os.unlink(temp_path)


def load_pm2_registry(v2_root):
    registry_path = os.path.join(v2_root, "pm2-artifacts", "module-registry-v1", "registry.json")
    registry = load_json_file(registry_path)
    if registry.get("registry_version") != "1.0" or not isinstance(registry.get("modules"), list):
        raise ValueError("PM2 Module Registry is invalid.")
    manifests = {}
    for record in registry["modules"]:
        module_id = record.get("module_id")
        manifest_relative = record.get("manifest")
        if not isinstance(module_id, str) or not isinstance(manifest_relative, str):
            raise ValueError("PM2 Module Registry contains an incomplete record.")
        manifest_path = os.path.abspath(os.path.join(v2_root, manifest_relative))
        if os.path.commonpath([v2_root, manifest_path]) != v2_root:
            raise ValueError("PM2 Module Manifest escapes the repository.")
        manifest = load_json_file(manifest_path)
        if not PM2_REQUIRED_MANIFEST_FIELDS.issubset(manifest):
            raise ValueError(f"Module Manifest is incomplete: {module_id}")
        if manifest.get("module_id") != module_id:
            raise ValueError(f"Module id mismatch: {module_id}")
        if "workspace_preview" not in manifest.get("allowed_slots", []):
            raise ValueError(f"Module is not allowed in workspace_preview: {module_id}")
        manifests[module_id] = manifest
    return registry, manifests


