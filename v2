        cmd_plan(args)
    elif args.command == "analyze":
        cmd_analyze(args)
    elif args.command == "design":
        if args.design_command == "generate":
            cmd_design_generate(args)
        elif args.design_command == "detail":
            cmd_design_detail(args)
        elif args.design_command == "show":
            cmd_design_show(args)
