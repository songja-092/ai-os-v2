def apply_pm4_project_ui_action(v2_root, payload):
    state = load_pm4_project_state(v2_root)
    if payload.get("request_id") != state["request_id"]:
        raise PermissionError("프로젝트 조사 요청이 다릅니다. 아무 내용도 변경하지 않았습니다.")
    action = payload.get("action")
    if action not in {"project.candidate.select", "project.candidate.clear"}:
        raise PermissionError("현재 PM4 MVP에서 허용되지 않은 행동입니다.")
    if action == "project.candidate.select":
        candidate_id = payload.get("candidate_id")
        if candidate_id not in {item["candidate_id"] for item in state["items"]}:
            raise ValueError("알 수 없는 프로젝트 조사 후보입니다.")
        state["selected_candidate_id"] = candidate_id
        state["selection_record"] = {
            "candidate_id": candidate_id,
            "selected_by": "user",
            "selected_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "input_method": "mouse_button_next",
            "recommendation_was_automatic_selection": False,
        }
        for item in state["items"]:
            item["lifecycle_status"] = "user_selected" if item["candidate_id"] == candidate_id else "candidate_preserved"
    else:
        state["selected_candidate_id"] = None
        state.pop("selection_record", None)
        for item in state["items"]:
            item["lifecycle_status"] = "candidate_preserved"
    state["revision"] = int(state.get("revision", 1)) + 1
    state["last_action"] = action
    write_json_atomic(os.path.join(v2_root, PM4_PROJECT_STATE_RELATIVE_PATH), state)
    if action == "project.candidate.select":
        write_pm4_project_handoff(v2_root, state)
    return pm4_project_ui_state(v2_root)


def swap_order(values, source_id, target_id):
    result = list(values)
    source = result.index(source_id)
    target = result.index(target_id)
    result[source], result[target] = result[target], result[source]
    return result


def apply_pm3_ui_action(v2_root, payload):
    state = load_pm3_editor_state(v2_root)
    if payload.get("project_id") != state["project_id"]:
        raise PermissionError("Project mismatch. No Draft was changed.")
    action = payload.get("action")
    if action not in state["allowed_actions"]:
        raise PermissionError("Action is not allowed by V2 Core.")

    if action == "section.select":
        card_id = payload.get("card_id")
        if card_id not in PM3_CARD_IDS:
            raise ValueError("Unknown card selection.")
        state["selected_card_id"] = card_id
    elif action in {"draft.undo", "draft.redo"}:
        source_key, target_key = ("past", "future") if action == "draft.undo" else ("future", "past")
        if state[source_key]:
            entry = state[source_key].pop()
            state[target_key].append({"design": json.loads(json.dumps(state["draft"])), "label": entry["label"]})
            state["draft"] = entry["design"]
    elif action == "draft.discard":
        state["draft"] = json.loads(json.dumps(state["applied"]))
        state["past"], state["future"] = [], []
    elif action == "draft.apply":
        state["applied"] = json.loads(json.dumps(state["draft"]))
        state["design_version"] = int(state.get("design_version", 1)) + 1
        state["past"], state["future"] = [], []
    elif action == "version.restore":
        fresh = default_pm3_editor_state()["applied"]
        state["past"].append({"design": json.loads(json.dumps(state["draft"])), "label": "초기 배치로 복원"})
        state["draft"] = fresh
        state["future"] = []
    else:
        before = json.loads(json.dumps(state["draft"]))
        label = "화면 수정"
        if action == "layout.move":
            source_id, target_id = payload.get("source_id"), payload.get("target_id")
            if source_id not in PM3_SECTION_IDS or target_id not in PM3_SECTION_IDS:
                raise ValueError("Unknown layout Section.")
            state["draft"]["layout_order"] = swap_order(state["draft"]["layout_order"], source_id, target_id)
            label = "패널 레이아웃 순서 변경"
        elif action == "card.move":
            source_id, target_id = payload.get("source_id"), payload.get("target_id")
            if source_id not in PM3_CARD_IDS or target_id not in PM3_CARD_IDS:
                raise ValueError("Unknown project card.")
            state["draft"]["card_order"] = swap_order(state["draft"]["card_order"], source_id, target_id)
            label = "프로젝트 카드 순서 변경"
        else:
            card_id = state["selected_card_id"]
            value = payload.get("value")
            if action == "style.set_color":
                if not isinstance(value, str) or not re.fullmatch(r"#[0-9a-fA-F]{6}", value):
                    raise ValueError("Choose a valid color.")
                state["draft"]["cards"][card_id]["color"] = value.lower()
                label = f"{card_id} 색상 변경"
            elif action == "style.set_font_size":
                if value not in PM3_FONT_SIZES:
                    raise ValueError("Choose an allowed font size.")
                state["draft"]["cards"][card_id]["font_size"] = value
                label = f"{card_id} 글씨 크기 변경"
            elif action == "card.set_size":
                if value not in PM3_CARD_SIZES:
                    raise ValueError("Choose an allowed card size.")
                state["draft"]["cards"][card_id]["size"] = value
                label = f"{card_id} 카드 크기 변경"
        if state["draft"] != before:
            state["past"].append({"design": before, "label": label})
            state["future"] = []

    state["dirty"] = state["draft"] != state["applied"]
    state["revision"] = int(state.get("revision", 1)) + 1
    state["last_action"] = action
    validate_pm3_editor_state(state)
    write_json_atomic(os.path.join(v2_root, PM3_STATE_RELATIVE_PATH), state)
    return pm3_ui_state(v2_root)


def apply_pm2_ui_action(v2_root, payload):
    state, manifests = load_pm2_board_state(v2_root)
    if payload.get("project_id") != state["project_id"]:
        raise PermissionError("Project mismatch. No state was changed.")
    action = payload.get("action")
    if action not in state["allowed_actions"]:
        raise PermissionError("Action is not allowed by V2 Core.")
    module_id = payload.get("module_id")
    module = next((item for item in state["modules"] if item["module_id"] == module_id), None)
    if action != "layout.restore" and module is None:
        raise ValueError("Registered Module not found.")

    if action == "layout.restore":
        restored = default_pm2_board_state()
        restored["revision"] = int(state.get("revision", 1)) + 1
        restored["last_action"] = action
        state = restored
    elif action == "module.enable":
        module.update({"enabled": True, "failed": False})
        state["active_module_id"] = module_id
    elif action == "module.disable":
        if not manifests[module_id]["permissions"].get("hideable"):
            raise PermissionError("This Module cannot be disabled.")
        module.update({"enabled": False, "failed": False})
        if state.get("active_module_id") == module_id:
            replacement = next((item for item in state["modules"] if item["module_id"] != module_id and item["enabled"] and not item["failed"]), None)
            state["active_module_id"] = replacement["module_id"] if replacement else module_id
    elif action == "module.simulate_failure":
        module.update({"enabled": True, "failed": True})
        if state.get("active_module_id") == module_id:
            replacement = next((item for item in state["modules"] if item["module_id"] != module_id and item["enabled"] and not item["failed"]), None)
            state["active_module_id"] = replacement["module_id"] if replacement else module_id
    elif action == "module.select":
        if not module["enabled"] or module["failed"]:
            raise PermissionError("비활성 또는 오류 상태인 Module은 열 수 없습니다.")
        state["active_module_id"] = module_id
    elif action in {"module.move_up", "module.move_down"}:
        if not manifests[module_id]["permissions"].get("movable"):
            raise PermissionError("This Module cannot be moved.")
        modules = sorted(state["modules"], key=lambda item: item["order"])
        current = modules.index(module)
        target = current - 1 if action == "module.move_up" else current + 1
        if 0 <= target < len(modules):
            modules[current], modules[target] = modules[target], modules[current]
        for index, item in enumerate(modules, start=1):
            item["order"] = index
        state["modules"] = modules

    if action != "layout.restore":
        state["revision"] = int(state.get("revision", 1)) + 1
        state["last_action"] = action
    validate_pm2_board_state(state, manifests)
    write_json_atomic(os.path.join(v2_root, PM2_STATE_RELATIVE_PATH), state)
    return pm2_ui_state(v2_root)


def resolve_pm2_product_asset(request_path):
    products = {
        "hospital": "/home/user/바탕화면/test_project/dist",
        "pdf": "/home/user/바탕화면/test_project/m7-pdf-stamp/dist",
    }
    relative = request_path.removeprefix("/pm2-product-preview/")
    product_id, separator, asset = relative.partition("/")
    if not separator or product_id not in products:
        raise ValueError("Unknown PM2 product preview.")
    asset = asset or "index.html"
    root = os.path.abspath(products[product_id])
    target = os.path.abspath(os.path.join(root, asset))
    if os.path.commonpath([root, target]) != root or not os.path.isfile(target):
        raise ValueError("PM2 product asset is unavailable.")
    return product_id, root, target


class DashboardHTTPRequestHandler(BaseHTTPRequestHandler):
