        return json.load(f)

def get_git_commit(repo_path):
    code, out, err = run_cmd("git rev-parse HEAD", cwd=repo_path)
    if code != 0:
        return None
    return out

def get_origin_main_commit(repo_path):
    code, out, err = run_cmd("git rev-parse origin/main", cwd=repo_path)
    if code == 0:
        return out
    code, out, err = run_cmd("git rev-parse remotes/origin/main", cwd=repo_path)
    if code == 0:
        return out
    return None

def get_git_branch(repo_path):
    code, out, err = run_cmd("git rev-parse --abbrev-ref HEAD", cwd=repo_path)
    if code != 0:
        return "unknown"
    return out

def check_git_safety(project_path):
    if not os.path.exists(project_path) or not os.path.isdir(project_path):
        return False, "Project path does not exist or is not a directory."

    # 1. Inside git work tree?
    code, out, err = run_cmd("git rev-parse --is-inside-work-tree", cwd=project_path)
    if code != 0 or out != "true":
        return False, "Project path is not a valid Git repository."

    # 2. Get HEAD commit
    head = get_git_commit(project_path)
    if not head:
        return False, "Failed to resolve HEAD commit of the project."

    # 3. Check uncommitted changes (dirty working tree)
    code, out, err = run_cmd("git status --porcelain", cwd=project_path)
    if code != 0:
        return False, f"Failed to check git status: {err}"
    if out:
        return False, f"Dirty working tree: uncommitted changes exist in project:\n{out}"

    # 4. Check for merge conflicts
    git_dir_code, git_dir, _ = run_cmd("git rev-parse --git-dir", cwd=project_path)
    if git_dir_code == 0:
        if not os.path.isabs(git_dir):
            git_dir = os.path.abspath(os.path.join(project_path, git_dir))
        if os.path.exists(os.path.join(git_dir, "MERGE_HEAD")):
            return False, "Conflict detected: MERGE_HEAD exists."

    conflict_code, conflict_out, _ = run_cmd("git diff --name-only --diff-filter=U", cwd=project_path)
    if conflict_code == 0 and conflict_out:
        return False, f"Conflict detected: unresolved merge conflicts exist:\n{conflict_out}"

    return True, "Git safety checks passed."

def get_active_run():
    v2_root = os.path.dirname(os.path.abspath(__file__))
    runs_dir = os.path.join(v2_root, "runs")
    if not os.path.exists(runs_dir):
        return None
    for run_id in os.listdir(runs_dir):
        run_file = os.path.join(runs_dir, run_id, "run.yml")
        if os.path.exists(run_file):
            run_data = read_yaml(run_file)
            if run_data and not run_data.get("is_legacy", False):
                status = run_data.get("status", "").lower()
                if status in ["created", "active", "paused"]:
                    return run_data
    return None

def get_git_changed_paths(project_path):
    result = subprocess.run(
        ["git", "status", "--porcelain=v1", "--untracked-files=all", "-z"],
        cwd=project_path,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=30,
    )
    if result.returncode != 0:
        raise RuntimeError(f"Failed to inspect project changes: {result.stderr.strip()}")

    paths = set()
    entries = result.stdout.split("\0")
    index = 0
    while index < len(entries):
        entry = entries[index]
        index += 1
        if not entry:
            continue
        status = entry[:2]
        path = entry[3:]
        if status[0] in {"R", "C"} and index < len(entries):
            path = entries[index]
            index += 1
        paths.add(path)
    return paths


def is_allowed_skill_change(path, allowed_roots):
    normalized = os.path.normpath(path)
    for root in allowed_roots:
        allowed = os.path.normpath(root)
        if normalized == allowed or normalized.startswith(allowed + os.sep):
            return True
    return False


def build_codex_exec_command(prompt, skip_git_repo_check=False):
    """Build the single supported non-interactive Codex invocation."""
    cmd = ["codex", "exec", "--approve-for-me", "--ephemeral"]
    if skip_git_repo_check:
        cmd.append("--skip-git-repo-check")
    cmd.append(prompt)
    return cmd


def run_skill(project_path, skill_name, prompt, timeout, allowed_roots):
    # Skill이 대상 프로젝트에 실제 설치되어 있어야 한다.
    skill_dir = os.path.join(project_path, ".agents", "skills", skill_name)
    skill_file = os.path.join(skill_dir, "SKILL.md")

    if not os.path.exists(skill_file):
        raise FileNotFoundError(f"Skill '{skill_name}' not found at {skill_file}")

    with open(skill_file, "r", encoding="utf-8") as sf:
        if not sf.read().strip():
            raise ValueError(f"Skill file {skill_file} is empty.")

    if not prompt.strip():
        raise ValueError("Skill prompt is empty.")

    before_changes = get_git_changed_paths(project_path)

    # Codex의 프로젝트 Skill 호출 문법을 그대로 사용한다. Skill 본문을 Prompt에 복제하지 않는다.
    skill_prompt = f"${skill_name} {prompt}"
    cmd = build_codex_exec_command(skill_prompt)

    env = os.environ.copy()
    env.pop("SPECKIT_INTEGRATION_CODEX_EXTRA_ARGS", None)

    try:
        result = subprocess.run(
            cmd,
            shell=False,
            cwd=project_path,
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired as exc:
        raise TimeoutError(f"Skill '{skill_name}' timed out after {timeout} seconds.") from exc

    after_changes = get_git_changed_paths(project_path)
    new_changes = after_changes - before_changes
    unexpected = sorted(
        path for path in new_changes if not is_allowed_skill_change(path, allowed_roots)
    )

    return {
        "command": [*cmd[:-1], f"${skill_name} <prompt>"],
        "returncode": result.returncode,
        "stdout": result.stdout,
        "stderr": result.stderr,
        "before_changes": sorted(before_changes),
        "after_changes": sorted(after_changes),
        "unexpected_changes": unexpected,
    }


def resolve_feature_artifacts(project_path):
    feature_json_path = os.path.join(project_path, ".specify", "feature.json")
    if not os.path.isfile(feature_json_path):
        return None, None, None
    try:
        with open(feature_json_path, "r", encoding="utf-8") as feature_file:
            feature_data = json.load(feature_file)
    except (OSError, json.JSONDecodeError):
        return None, None, None

    feature_dir = feature_data.get("feature_directory")
    if not isinstance(feature_dir, str) or not feature_dir.strip():
        return None, None, None
    feature_dir = os.path.normpath(feature_dir)
    if os.path.isabs(feature_dir) or feature_dir == ".." or feature_dir.startswith(".." + os.sep):
        return None, None, None

    project_root = os.path.realpath(project_path)
    absolute_feature_dir = os.path.realpath(os.path.join(project_root, feature_dir))
    if os.path.commonpath([project_root, absolute_feature_dir]) != project_root:
        return None, None, None

    return (
        feature_dir,
        os.path.join(absolute_feature_dir, "spec.md"),
        os.path.join(absolute_feature_dir, "checklists", "requirements.md"),
    )


def write_skill_log(log_path, skill_name, result):
    with open(log_path, "w", encoding="utf-8") as log_file:
        log_file.write(f"Executed Skill: {skill_name}\n")
        log_file.write(f"Command: {json.dumps(result['command'], ensure_ascii=False)}\n")
        log_file.write(f"Exit Code: {result['returncode']}\n")
        log_file.write(f"Unexpected Changes: {json.dumps(result['unexpected_changes'], ensure_ascii=False)}\n")
        log_file.write("--- Stdout ---\n")
        log_file.write(result["stdout"])
        log_file.write("\n--- Stderr ---\n")
        log_file.write(result["stderr"])

def cmd_create(args):
    project_path = os.path.abspath(args.project)

    # 1. Active Run Check (Limit to 1 active run at a time)
    active_run = get_active_run()
    if active_run:
        print(f"Error: Active Run already exists. Cannot create a new one.", file=sys.stderr)
        print(f"Existing Run ID: {active_run.get('run_id')}", file=sys.stderr)
        print(f"Current Status: {active_run.get('status')}", file=sys.stderr)
        sys.exit(1)

    # 2. Git Safety check
    success, msg = check_git_safety(project_path)
    if not success:
        print(f"Error: Git Safety Check Failed.\nReason: {msg}", file=sys.stderr)
        sys.exit(1)

    # 3. Retrieve commits and branches
    v2_root = os.path.dirname(os.path.abspath(__file__))
    base_memory_commit_official = get_origin_main_commit(v2_root)
    base_memory_commit_local = get_git_commit(v2_root)

    v2_workspace_branch = get_git_branch(v2_root)
    project_branch = get_git_branch(project_path)
    base_project_commit = get_git_commit(project_path)

    if not base_memory_commit_official:
        print("Error: Failed to resolve Base Memory Commit (origin/main HEAD).", file=sys.stderr)
        sys.exit(1)

    # 4. Generate unique Run ID (8-char hex UUID)
    run_id = f"run-{uuid.uuid4().hex[:8]}"

    # 하나의 사용자 명령은 V2 Run 하나만 만든다.
    run_dir_path = os.path.join(v2_root, "runs", run_id)
    os.makedirs(run_dir_path, exist_ok=True)
    run_file = os.path.join(run_dir_path, "run.yml")
    log_file_path = os.path.join(run_dir_path, "skill-speckit-specify.log")

    run_data = {
        "run_id": run_id,
        "run_type": args.type,
        "request": args.spec,
        "stage": "intake",
        "status": "active",
        "created_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "git_safety_at_creation": "PASS",
        "requirements_version": 1,
        "requirements_status": "generating",
        "requirements_artifact": None,
        "requirements_checklist": None,
        "execution_path": "standard",
        "approval": {"status": "pending", "approved_version": None, "approved_at": None},
        "next_stage_allowed": False,
        "memory": {"official_branch": "main", "official_commit": base_memory_commit_official},
        "v2_workspace": {"branch": v2_workspace_branch, "head": base_memory_commit_local},
        "project": {"path": project_path, "branch": project_branch, "base_commit": base_project_commit},
        "integrations": {"spec_kit": {"execution_mode": "skills", "workflow_run_id": None}},
    }
    write_yaml(run_file, run_data)

    print("요청을 받았습니다. 요구사항을 정리하고 있습니다...")

    try:
        non_interactive_guard = (
            "\n\n[IMPORTANT: You are running in an automated non-interactive batch environment. "
            "Do NOT ask any clarification questions. "
            "If there are any ambiguities, resolve them by making reasonable assumptions and document them under the 'Assumptions' section in the specification. "
            "Produce the final files immediately and exit successfully.]"
        )
        spec_prompt = args.spec + non_interactive_guard
        skill_result = run_skill(
            project_path,
            "speckit-specify",
            spec_prompt,
            600,
            [".specify/feature.json", "specs"],
        )
    except Exception as e:
        run_data["status"] = "failed"
        run_data["requirements_status"] = "failed"
        run_data["failure_reason"] = str(e)
        write_yaml(run_file, run_data)
        print("요구사항 문서를 만들지 못했습니다.", file=sys.stderr)
        print(f"원인: {e}", file=sys.stderr)
        sys.exit(1)

    write_skill_log(log_file_path, "speckit-specify", skill_result)

    feature_dir, spec_path, checklist_path = resolve_feature_artifacts(project_path)
    has_spec = bool(spec_path and os.path.isfile(spec_path) and os.path.getsize(spec_path) > 0)
    has_checklist = bool(
        checklist_path and os.path.isfile(checklist_path) and os.path.getsize(checklist_path) > 0
    )
    new_changes = set(skill_result["after_changes"]) - set(skill_result["before_changes"])
    invocation_changed_feature = bool(
        feature_dir
        and any(
            is_allowed_skill_change(path, [feature_dir, ".specify/feature.json"])
            for path in new_changes
        )
    )

    if (
        skill_result["returncode"] != 0
        or skill_result["unexpected_changes"]
        or not has_spec
        or not has_checklist
        or not invocation_changed_feature
    ):
        run_data["status"] = "failed"
        run_data["requirements_status"] = "failed"
        run_data["failure_reason"] = "Skill execution or required Artifact validation failed."
        write_yaml(run_file, run_data)
        print("요구사항 문서를 만들지 못했습니다.", file=sys.stderr)
        print(
            "원인: Skill 종료코드, 변경 범위, spec.md 또는 요구사항 체크리스트 검증에 실패했습니다. "
            f"(Exit Code: {skill_result['returncode']})",
            file=sys.stderr,
        )
        print(f"로그 위치: {log_file_path}", file=sys.stderr)
        sys.exit(1)

    run_data["status"] = "created"
    run_data["requirements_status"] = "awaiting_user_review"
    run_data["requirements_artifact"] = spec_path
    run_data["requirements_checklist"] = checklist_path
    write_yaml(run_file, run_data)

    # Output Verification
    print("AI OS V2 — M2.0\n")
    print(f"Run ID:\n{run_id}\n")
    print(f"Request:\n{args.spec}\n")
    print(f"Project Path:\n{project_path}\n")
    print(f"Project Branch:\n{project_branch}\n")
    print(f"Base Memory (Official):\n{base_memory_commit_official}\n")
    print(f"V2 Workspace Branch:\n{v2_workspace_branch}\n")
    print(f"V2 Workspace HEAD:\n{base_memory_commit_local}\n")
    print(f"Base Project Commit:\n{base_project_commit}\n")
    print("Stage:\nIntake\n")
    print("Status:\nCreated\n")
    print("Git Safety at Creation:\nPASS\n")
    print("Git Safety Now:\nPASS")

