                os.path.join("output", "analysis.md"),
                os.path.join("output", "user-summary.md"),
            }
            actual_temp_files = {
                os.path.relpath(os.path.join(root, name), isolation.name)
                for root, _, names in os.walk(isolation.name)
                for name in names
            }
            unexpected_temp = sorted(actual_temp_files - allowed_temp_files)
            if unexpected_temp:
                raise RuntimeError(f"Unexpected files in isolated workspace: {unexpected_temp}")
            source_result = validate_source_analysis_artifacts(isolation.name, isolated["output_dir"])
            shutil.copy2(source_result["source_path"], source_input_path)
            official_paths = {}
            for label, source_path in source_result["paths"].items():
                target_path = os.path.join(run_dir, os.path.basename(source_path))
                shutil.copy2(source_path, target_path)
                official_paths[label] = target_path
            paths = official_paths
            selected_recipe = "source-evaluation"
            next_action = source_result["next_action"]
            urls = source_result["urls"]
            run_data["source"].update({
                "access_status": source_result["access_status"],
                "transcript_status": source_result["transcript_status"],
                "content_scope": source_result["content_scope"],
            })
            run_data["collection_analysis"].update({
                "disposition": source_result["disposition"],
                "official_sources_verified": source_result["official_sources_verified"],
            })
        else:
            paths, selected_recipe, next_action, urls = validate_collection_analysis_artifacts(run_dir)
        run_data["status"] = "awaiting_user_review"
        run_data["collection_analysis"].update({
            "status": "awaiting_user_review",
            "research_artifact": paths["research"],
            "analysis_artifact": paths["analysis"],
            "user_summary_artifact": paths["user_summary"],
            "selected_recipe": selected_recipe,
            "recipe_status": "researched",
            "next_action": next_action,
            "source_url_count": len(urls),
            "completed_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        })
        run_data["collection_analysis"]["validation"] = {
            "status": "PASS",
            "profile": run_data["collection_analysis"]["analysis_kind"],
            "errors": [],
        }
        write_yaml(run_file, run_data)
    except Exception as exc:
        run_data["status"] = "failed"
        run_data["next_stage_allowed"] = False
        run_data["preview_gate"] = "blocked_collection_analysis_failed"
        run_data["failure_reason"] = str(exc)
        run_data["collection_analysis"]["status"] = "failed"
        run_data["collection_analysis"]["validation"] = {
            "status": "failed",
            "profile": run_data["collection_analysis"].get("analysis_kind"),
            "errors": [str(exc)],
        }
        write_yaml(run_file, run_data)
        print(f"Error: Collection-analysis failed: {exc}", file=sys.stderr)
        print(f"Run ID: {run_id}", file=sys.stderr)
        print(f"Log: {log_path}", file=sys.stderr)
        sys.exit(1)
    finally:
        if isolation is not None:
            isolation.cleanup()

    print(f"AI OS V2 Collection Analysis Run: {run_id}")
    print("Status: awaiting_user_review")
    print(f"Selected Recipe: {selected_recipe}")
    print(f"Next Action: {next_action}")
    print(f"User Summary: {paths['user_summary']}")

def cmd_create(args):
