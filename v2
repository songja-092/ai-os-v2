def parse_design_import_images(values):
    images = {}
    for value in values:
        if "=" not in value:
            raise ValueError("Each --image must use OPTION=/absolute/path format.")
        option, path = value.split("=", 1)
        option = option.strip().upper()
        if not re.fullmatch(r"[A-Z][A-Z0-9-]{0,31}", option):
            raise ValueError(f"Invalid design option name: {option}")
        if option in images:
            raise ValueError(f"Duplicate design option: {option}")
        images[option] = inspect_design_image(os.path.abspath(path))
    if not images:
        raise ValueError("At least one --image is required.")
    return images


def parse_design_references(values):
    references = []
    required = {"name", "url", "referenced_pattern", "applied_section_ids"}
    for raw in values or []:
        try:
            reference = json.loads(raw)
        except json.JSONDecodeError as exc:
            raise ValueError(f"Invalid --reference-json value: {exc}") from exc
        if not isinstance(reference, dict) or not required.issubset(reference):
            raise ValueError(f"Reference requires fields: {sorted(required)}")
        if not isinstance(reference["applied_section_ids"], list) or not reference["applied_section_ids"]:
            raise ValueError("Reference applied_section_ids must be a non-empty list.")
        reference["registration_status"] = "not_registered"
        reference["input_only"] = True
        references.append(reference)
    return references


def validate_design_identifier(value, label="Design identifier"):
    normalized = (value or "").strip().upper()
    if not normalized or len(normalized) > 64:
        raise ValueError(f"{label} must contain 1-64 characters.")
    if not re.fullmatch(r"[A-Z0-9]+(?:[+_-][A-Z0-9]+)*", normalized):
        raise ValueError(f"Invalid {label.lower()}: {value}")
    return normalized


def require_regular_file(path, label):
    absolute = os.path.abspath(path)
    if not os.path.isfile(absolute) or os.path.islink(absolute) or os.path.getsize(absolute) <= 0:
        raise ValueError(f"{label} must be an existing non-empty regular file: {absolute}")
    return absolute


def require_path_within(path, roots, label):
    resolved = os.path.realpath(path)
    allowed = [os.path.realpath(root) for root in roots if root]
    if not any(resolved == root or resolved.startswith(root + os.sep) for root in allowed):
        raise ValueError(f"{label} is outside the allowed roots: {resolved}")
    return resolved


def load_json_object(path, label):
    path = require_regular_file(path, label)
    with open(path, "r", encoding="utf-8") as handle:
        value = json.load(handle)
    if not isinstance(value, dict):
        raise ValueError(f"{label} must contain one JSON object.")
    return path, value


