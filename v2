def cmd_design_import(args):
    run_file = get_run_file(args.run_id)
    if not os.path.isfile(run_file):
        print(f"Error: Run '{args.run_id}' not found.", file=sys.stderr)
        sys.exit(1)
    run_data = read_yaml(run_file)
    if run_data.get("is_legacy") or run_data.get("status") in {"failed", "rejected", "cancelled"}:
        print("Error: Run state blocks design import.", file=sys.stderr)
        sys.exit(1)

    project_path = run_data.get("project", {}).get("path")
    if not project_path or not os.path.isdir(project_path):
        print("Error: Run project path is unavailable.", file=sys.stderr)
        sys.exit(1)

    lock_path = os.path.join(os.path.dirname(run_file), "design-import.lock")
    temp_dir = None
    lock_acquired = False
    try:
        lock_fd = os.open(lock_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
        lock_acquired = True
        os.write(lock_fd, str(os.getpid()).encode("ascii"))
        os.close(lock_fd)

        images = parse_design_import_images(args.image)
        references = parse_design_references(args.reference_json)
        selection = args.selection.strip().upper()
        mix_components = [value.strip().upper() for value in (args.mix_component or [])]
        if re.fullmatch(r"MIX-[A-Z0-9-]+", selection):
            if len(mix_components) < 2 or any(component not in images for component in mix_components):
                raise ValueError("A MIX selection requires at least two imported --mix-component options.")
        elif selection not in images:
            raise ValueError("Selection must be an imported option or a MIX-* identifier.")

        exploration = run_data.get("design_exploration", {})
        version = int(exploration.get("version") or 0) + 1
        artifact_dir = os.path.join(project_path, "design-artifacts", args.run_id, f"v{version}")
        if os.path.exists(artifact_dir):
            raise FileExistsError(f"Version Artifact already exists: {artifact_dir}")
        artifact_parent = os.path.dirname(artifact_dir)
        os.makedirs(artifact_parent, exist_ok=True)
        temp_dir = tempfile.mkdtemp(prefix=f".v{version}-import-", dir=artifact_parent)

        imported = {}
        original_evidence = {}
        for option, metadata in images.items():
            original_evidence[option] = {
                "sha256": metadata["sha256"],
                "bytes": metadata["bytes"],
            }
            target_name = f"direction-{option.lower()}{metadata['extension']}"
            target_path = os.path.join(temp_dir, target_name)
            shutil.copyfile(metadata["source_path"], target_path)
            copied = inspect_design_image(target_path)
            if copied["sha256"] != metadata["sha256"] or copied["bytes"] != metadata["bytes"]:
                raise RuntimeError(f"Imported image verification failed for option {option}.")
            imported[option] = {
                "path": target_name,
                "sha256": copied["sha256"],
                "mime": copied["mime"],
                "width": copied["width"],
                "height": copied["height"],
                "bytes": copied["bytes"],
                "source_path": metadata["source_path"],
                "origin": "imported_external_visual_exploration",
                "generated_inside_run": False,
            }

        for option, metadata in images.items():
            current = inspect_design_image(metadata["source_path"])
            if current["sha256"] != original_evidence[option]["sha256"] or current["bytes"] != original_evidence[option]["bytes"]:
                raise RuntimeError(f"Original design image changed during import: {option}")

        manifest = {
            "schema_version": 1,
            "run_id": args.run_id,
            "artifact_version": version,
            "artifact_type": "imported_external_visual_exploration",
            "source": {
                "generated_by": args.generated_by,
                "generation_tool": args.generation_tool,
                "source_run_id": args.source_run_id,
                "generated_inside_run": False,
                "prompt_path": os.path.abspath(args.prompt_path) if args.prompt_path else None,
            },
            "images": imported,
            "references": references,
            "selection": {
                "id": selection,
                "type": "mixed" if selection.startswith("MIX-") else "single",
                "components": mix_components if selection.startswith("MIX-") else [selection],
                "approved_by": "user",
                "approved_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            },
            "reference_library_registration": "prohibited_without_separate_user_approval",
            "design_draft": {"status": "ready_to_create", "next_version": 1},
            "imported_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        }
        manifest_path = os.path.join(temp_dir, "manifest.json")
        with open(manifest_path, "w", encoding="utf-8") as manifest_file:
            json.dump(manifest, manifest_file, ensure_ascii=False, indent=2)
            manifest_file.write("\n")
        os.rename(temp_dir, artifact_dir)
        temp_dir = None

        run_data["design_exploration"] = {
            "version": version,
            "status": "selected_direction_ready_for_design_draft",
            "artifact_type": "imported_external_visual_exploration",
            "artifact_path": artifact_dir,
            "manifest_path": os.path.join(artifact_dir, "manifest.json"),
            "generated_inside_run": False,
            "selected_direction": selection,
            "selected_components": mix_components if selection.startswith("MIX-") else [selection],
            "user_result": "approved_visual_direction",
            "reference_count": len(references),
            "reference_library_registered": False,
            "design_draft": {"status": "ready_to_create", "next_version": 1},
        }
        write_yaml(run_file, run_data)
        print(f"Imported design exploration v{version} for {args.run_id}")
        print(f"Artifact: {artifact_dir}")
        print(f"Selected direction: {selection}")
        print("Design Draft v1: ready_to_create")
    except Exception as exc:
        if temp_dir and os.path.isdir(temp_dir):
            shutil.rmtree(temp_dir)
        print(f"Error: Design import failed: {exc}", file=sys.stderr)
        sys.exit(1)
    finally:
        if lock_acquired and os.path.exists(lock_path):
            os.unlink(lock_path)


