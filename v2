        raise PermissionError("현재 PM4 Core에서 저장할 수 없는 행동입니다.")
    item_id = payload.get("item_id")
    if item_id not in {item.get("item_id") for item in state["items"]}:
        raise ValueError("알 수 없는 조사 결과입니다.")
    if action == "research.decision.set":
        decision = payload.get("decision")
        if decision not in PM4_DECISIONS:
            raise ValueError("채택·보류·폐기 중 하나를 선택해주세요.")
        state["decisions"][item_id] = decision
    else:
        state["decisions"].pop(item_id, None)
    selected = next(item for item in state["items"] if item["item_id"] == item_id)
    memory_path = os.path.join(v2_root, PM4_CHANNEL_MEMORY_RELATIVE_PATH)
    memory = load_json_file(memory_path) if os.path.exists(memory_path) else {"schema_version": "1.0", "channels": []}
    key = (selected.get("platform"), selected.get("channel"))
    memory["channels"] = [record for record in memory.get("channels", []) if (record.get("platform"), record.get("channel")) != key]
    if state["decisions"].get(item_id) == "adopt" and selected.get("channel"):
        memory["channels"].append({
            "platform": selected["platform"], "channel": selected["channel"],
            "channel_url": selected.get("channel_url"), "source_item_id": item_id,
            "priority": "adopted_first", "approved_by": "user",
        })
    write_json_atomic(memory_path, memory)
    state["revision"] = int(state.get("revision", 1)) + 1
    state["last_action"] = action
    write_json_atomic(os.path.join(v2_root, PM4_STATE_RELATIVE_PATH), state)
    return pm4_ui_state(v2_root)


def load_pm4_project_state(v2_root):
    state_path = os.path.join(v2_root, PM4_PROJECT_STATE_RELATIVE_PATH)
    if not os.path.exists(state_path):
        raise ValueError("PM4 project collector state has not been built yet.")
    state = load_json_file(state_path)
    if state.get("request_id") != PM4_PROJECT_REQUEST_ID:
        raise ValueError("PM4 project request does not match the confirmed interview.")
    items = state.get("items")
    if not isinstance(items, list) or len(items) != 5:
        raise ValueError("PM4 project collector must expose five candidates for this approved MVP.")
    ids = {item.get("candidate_id") for item in items}
    if None in ids or len(ids) != len(items):
        raise ValueError("PM4 project candidate ids are invalid or duplicated.")
    selected = state.get("selected_candidate_id")
    if selected is not None and selected not in ids:
        raise ValueError("PM4 project selection points to an unknown candidate.")
    return state


