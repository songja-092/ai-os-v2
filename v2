    design_show_parser.add_argument("run_id", help="The existing Run ID")
    design_detail_parser = design_subparsers.add_parser("detail", help="Generate the mobile-first C v2 detail")
    design_detail_parser.add_argument("run_id", help="The existing Run ID")
