def cmd_spec_modify(args):
    v2_root = os.path.dirname(os.path.abspath(__file__))
    run_file = os.path.join(v2_root, "runs", args.run_id, "run.yml")
    if not os.path.exists(run_file):
        print(f"Error: Run '{args.run_id}' not found.", file=sys.stderr)
        sys.exit(1)
        
    run_data = read_yaml(run_file)
    project_path = run_data.get("project", {}).get("path")
    spec_path = get_spec_path(project_path)
    
    if not spec_path or not os.path.exists(spec_path):
        print("Error: Specification file not found yet.", file=sys.stderr)
        sys.exit(1)
        
    with open(spec_path, "r", encoding="utf-8") as f:
        old_content = f.read()
        
    version = run_data.get("requirements_version", 1)
    backup_path = f"{spec_path}.v{version}"
    with open(backup_path, "w", encoding="utf-8") as f:
        f.write(old_content)
        
    feedback_section = f"\n\n## Feedback & Modifications (Version {version + 1})\n- Requested changes: {args.comment}\n- Date: {datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}\n"
    new_content = old_content + feedback_section
    with open(spec_path, "w", encoding="utf-8") as f:
        f.write(new_content)
        
    run_data["requirements_version"] = version + 1
    run_data["requirements_status"] = "awaiting_user_review"
    run_data["approval"] = {
        "status": "pending",
        "approved_version": None,
        "approved_at": None
    }
    run_data["next_stage_allowed"] = False
    write_yaml(run_file, run_data)
    
    print(f"Success: Specification updated to Version {version + 1}.\n")
    print("=== Diff (Before vs After Modification) ===")
    diff = difflib.unified_diff(
        old_content.splitlines(keepends=True),
        new_content.splitlines(keepends=True),
        fromfile=f"spec.md (v{version})",
        tofile=f"spec.md (v{version+1})"
    )
    sys.stdout.writelines(diff)

