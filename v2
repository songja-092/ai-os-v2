        write_yaml(run_file, run_data)

        ui_log = os.path.join(run_dir, f"design-v{version}-ui-ux-pro-max.log")
        renderer_log = os.path.join(run_dir, f"design-v{version}-frontend-app-builder.log")
        verification_log = os.path.join(run_dir, f"design-v{version}-frontend-testing-debugging.log")
        run_data["design"]["logs"] = {
            "ui_ux_pro_max": ui_log,
            "renderer": renderer_log,
            "verification": verification_log,
        }
        write_yaml(run_file, run_data)
        run_ui_ux_pro_max(ui_skill_file, artifact_dir, ui_log)

        renderer_prompt = f"""Create the M3 static A/B design Preview for V2 Run {args.run_id}.
Read the approved specification at {spec_path}, the plan at {plan_path}, and UI UX Pro Max output at {artifact_dir}/design-system.md.
Write only inside {artifact_dir}. Do not change existing manual Preview files or product source. Do not install packages and do not use Image Gen for this constrained static Preview.
Create index.html, styles.css, and design-options.yml. Minimal inline JavaScript is allowed in index.html.
The page must open with option A in Mobile view and provide working controls for A/B and Mobile/PC views. Mobile is the primary design and review baseline; PC is a secondary responsive check.
A: warm neighborhood clinic; story-first Hero; order hospital introduction -> wide friendly clinician profiles -> soft hours guide -> reservation form -> completion panel.
B: professional medical center; operational Hero; core services and hours immediately below; desktop two-column information plus independent reservation panel; dense horizontal clinician rows; mobile order core info -> reservation jump -> clinicians -> hospital guide.
Options A and B must differ in at least four structural dimensions: Hero, section order, hours placement, clinician structure, reservation location, navigation, or mobile flow. They must remain distinguishable without color or images.
Include missing-photo fallback, form error example, completion example, mobile and desktop responsive CSS, semantic HTML, keyboard-visible controls, no horizontal overflow, and no functionality outside the approved scope.
design-options.yml must record both layout_archetype values, section_order arrays, and at least four structural_differences.
Produce the files immediately, do not ask questions, and exit."""
        renderer_result = run_skill(
            project_path,
            "frontend-app-builder",
            renderer_prompt,
            900,
            [relative_artifact],
        )
        write_skill_log(renderer_log, "build-web-apps:frontend-app-builder", renderer_result)
        required = ["index.html", "styles.css", "design-system.md", "design-options.yml"]
        missing = [name for name in required if not os.path.isfile(os.path.join(artifact_dir, name)) or os.path.getsize(os.path.join(artifact_dir, name)) == 0]
        if renderer_result["returncode"] != 0 or renderer_result["unexpected_changes"] or missing:
            raise RuntimeError(
                f"Preview renderer validation failed: exit={renderer_result['returncode']}, "
                f"unexpected={renderer_result['unexpected_changes']}, missing={missing}"
            )

        base_url = ensure_preview_server(project_path, run_dir)
        preview_url = f"{base_url}/{args.run_id}/v{version}/"
        verification_prompt = f"""Validate the static M3 Preview at {preview_url} for V2 Run {args.run_id}.
Use the Browser plugin first. Test A/B switching and Mobile/PC switching, page identity, meaningful content, Console errors, horizontal overflow, missing clinician fallback, reservation form/error example, completion panel, and approved-scope compliance.
Also verify the AI-pattern checklist: no invented metrics/testimonials, no decorative badge or fake dashboard chrome, no repetitive generic card grid, no emoji icons, and clear Korean healthcare copy.
Confirm A/B differ structurally in at least four required dimensions and remain distinguishable without relying on color or images.
Write only {artifact_dir}/verification.json as a JSON object containing overall_status, checks, structural_difference_count, ai_tells, console_errors, tested_viewports, tested_at, and preview_url. overall_status must be PASS only if every required check passes. Do not modify any other file. Do not ask questions; perform the validation and exit."""
        verification_result = run_skill(
            project_path,
            "frontend-testing-debugging",
            verification_prompt,
            900,
            [relative_artifact],
        )
        write_skill_log(verification_log, "build-web-apps:frontend-testing-debugging", verification_result)
        verification_path = os.path.join(artifact_dir, "verification.json")
        if not os.path.isfile(verification_path) or os.path.getsize(verification_path) == 0:
            raise RuntimeError("Browser verification Artifact was not created.")
        with open(verification_path, "r", encoding="utf-8") as verification_file:
            verification = json.load(verification_file)
        if (
            verification_result["returncode"] != 0
            or verification_result["unexpected_changes"]
            or verification.get("overall_status") != "PASS"
            or int(verification.get("structural_difference_count", 0)) < 4
        ):
            raise RuntimeError("Browser or structural verification did not PASS.")

        run_data["design"].update({
            "status": "awaiting_design_review",
            "preview_url": preview_url,
            "completed_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "logs": {
                "ui_ux_pro_max": ui_log,
                "renderer": renderer_log,
                "verification": verification_log,
            },
            "technical_verification": "PASS",
            "verification_artifact": verification_path,
        })
        write_yaml(run_file, run_data)
        print(f"Design Preview generated for {args.run_id}")
        print(f"Preview URL: {preview_url}")
        print("Status: awaiting_design_review")
    except Exception as exc:
        if run_file and run_data:
            run_data.setdefault("design", {})["status"] = "design_failed"
            run_data["design"]["failure_reason"] = str(exc)
            write_yaml(run_file, run_data)
        print(f"Error: M3 design generation failed: {exc}", file=sys.stderr)
        sys.exit(1)
    finally:
        if lock_path and os.path.exists(lock_path):
            os.unlink(lock_path)


