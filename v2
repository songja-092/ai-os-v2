    cards = design.get("cards", {})
    if set(cards) != PM3_CARD_IDS:
        raise ValueError("PM3 card style records are incomplete.")
    for card_id, style in cards.items():
        color = style.get("color", "")
        if not isinstance(color, str) or not re.fullmatch(r"#[0-9a-fA-F]{6}", color):
            raise ValueError(f"Invalid card color: {card_id}")
        if style.get("font_size") not in PM3_FONT_SIZES or style.get("size") not in PM3_CARD_SIZES:
            raise ValueError(f"Invalid card size preset: {card_id}")
    return design


