        if label not in research:
            raise ValueError(f"research.md is missing source-analysis section: {label}")
    for label in ["자료 핵심 요약", "언급된 도구", "V2에서 비어 있는 역할", "예상 효과", "복잡도", "작은 파일럿"]:
        if label not in analysis:
            raise ValueError(f"analysis.md is missing source-analysis section: {label}")
    for label in ["확인한 범위", "확인하지 못한 범위", "공식 확인", "판정", "내가 할 일"]:
        if label not in summary:
            raise ValueError(f"user-summary.md is missing source-analysis section: {label}")
    recipe_match = re.search(r"^selected_recipe:\s*source-evaluation\s*$", analysis, re.MULTILINE)

    access_match = re.search(r"^access_status:\s*(accessible|partial|unavailable)\s*$", source_text, re.MULTILINE)
    transcript_match = re.search(
        r"^transcript_status:\s*(full|partial|unavailable|not_applicable|unknown)\s*$",
        source_text,
        re.MULTILINE,
    )
    scope_match = re.search(r"^content_scope:\s*([^\n]+)$", source_text, re.MULTILINE)
    disposition_match = re.search(
        r"^disposition:\s*(discarded|deferred|candidate|pilot_ready|needs_more_source)\s*$",
        analysis,
        re.MULTILINE,
    )
    verified_match = re.search(r"^official_sources_verified:\s*(true|false)\s*$", analysis, re.MULTILINE)
    next_match = re.search(
        r"^next_action:\s*(register_candidate|prepare_pilot|discard|defer|request_more_source)\s*$",
        analysis,
        re.MULTILINE,
    )
    if not all([recipe_match, access_match, transcript_match, scope_match, disposition_match, verified_match, next_match]):
        raise ValueError("Source-analysis machine-readable markers are missing or invalid.")
    disposition = disposition_match.group(1)
    official_verified = verified_match.group(1) == "true"
    if disposition in {"candidate", "pilot_ready"} and not official_verified:
        raise ValueError("candidate or pilot_ready requires official source verification.")
    if official_verified and len(urls) < 2:
        raise ValueError("Official cross-verification requires the provided URL plus an official source URL.")
    return {
        "source_path": source_path,
        "paths": paths,
        "access_status": access_match.group(1),
        "transcript_status": transcript_match.group(1),
        "content_scope": scope_match.group(1).strip(),
        "disposition": disposition,
        "official_sources_verified": official_verified,
        "next_action": next_match.group(1),
        "urls": urls,
    }


