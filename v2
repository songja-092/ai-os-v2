    if not os.path.exists(run_file):
        print(f"Error: Run '{args.run_id}' not found.", file=sys.stderr)
        sys.exit(1)

    run_data = read_yaml(run_file)
    if run_data.get("status") in ["cancelled", "failed"] or run_data.get("requirements_status") == "rejected":
        print("Error: Cannot modify a cancelled, failed, or rejected run.", file=sys.stderr)
        sys.exit(1)

    project_path = run_data.get("project", {}).get("path")
    spec_path = get_spec_path(project_path)

    if not spec_path or not os.path.exists(spec_path):
        print("Error: Specification file not found yet.", file=sys.stderr)
        sys.exit(1)

    # 1. Read old content
    with open(spec_path, "r", encoding="utf-8") as f:
        old_content = f.read()

    # 2. Create OS temp directory (Isolated spec modify)
    temp_dir = tempfile.mkdtemp()
    tmp_path = os.path.join(temp_dir, "spec.md.tmp")
    with open(tmp_path, "w", encoding="utf-8") as f:
        f.write(old_content)

    # 3. Call Codex exec on spec.md.tmp non-interactively within the temp dir
    prompt = (
        f"아래 피드백을 바탕으로 {tmp_path} 파일의 명세를 직접 수정해줘. "
        f"수정 요청 사항은 단순히 파일 끝에 추가하는 형태는 실패이며, 기존 요구사항, User Scenario, "
        f"Acceptance Criteria 또는 제외 범위 등의 적절한 본문 위치에 실제로 내용을 반영하고 문장을 수정해야 해.\n\n"
        f"피드백: {args.comment}"
    )

    # 비대화형 가드 추가
    non_interactive_guard = (
        "\n\n[IMPORTANT: You are running in a automated non-interactive batch environment. "
        "Do NOT ask any clarification questions. "
        "Do NOT wait for choices. "
        "Directly write modifications to the spec file and exit immediately.]"
    )
    prompt += non_interactive_guard

    print("Codex를 통해 명세를 수정하고 있습니다...")
    env = os.environ.copy()
    env.pop("SPECKIT_INTEGRATION_CODEX_EXTRA_ARGS", None)
    try:
        res = subprocess.run(
            build_codex_exec_command(prompt, skip_git_repo_check=True),
            cwd=temp_dir,
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=180
        )
    except subprocess.TimeoutExpired:
        print("Error: Codex execution timed out (3 minutes). Original state preserved.", file=sys.stderr)
        shutil.rmtree(temp_dir)
        sys.exit(1)

    # 4. Validate exit code
    if res.returncode != 0:
        print(f"Error: Codex failed with exit code {res.returncode}.", file=sys.stderr)
        print(f"Stderr: {res.stderr}", file=sys.stderr)
        shutil.rmtree(temp_dir)
        sys.exit(1)

    # 5. Check if spec.md.tmp is empty
    if not os.path.exists(tmp_path) or os.path.getsize(tmp_path) == 0:
        print("Error: Spec modification result is empty.", file=sys.stderr)
        shutil.rmtree(temp_dir)
        sys.exit(1)

    # 6. Read new modified content from temp folder
    with open(tmp_path, "r", encoding="utf-8") as f:
        new_content = f.read()

    # 7. Check if core requirement content actually changed (not just feedback log)
    def get_core_spec(content):
        for idx, line in enumerate(content.splitlines()):
            if "## Feedback" in line or "Feedback & Modifications" in line:
                return "\n".join(content.splitlines()[:idx]).strip()
        return content.strip()

    old_core = get_core_spec(old_content)
    new_core = get_core_spec(new_content)

    if old_core == new_core:
        print("Error: Spec modification failed. Feedback history was added, but the core specification content did not change.", file=sys.stderr)
        shutil.rmtree(temp_dir)
        sys.exit(1)

    # 8. All safety checks passed. Update spec file, save backup and write yaml.
    version = run_data.get("requirements_version", 1)
    backup_path = f"{spec_path}.v{version}"

    with open(backup_path, "w", encoding="utf-8") as f:
        f.write(old_content)

    replacement_path = spec_path + ".replacement"
    with open(replacement_path, "w", encoding="utf-8") as f:
        f.write(new_content)
    os.replace(replacement_path, spec_path)

    # Cleanup temp folder
    shutil.rmtree(temp_dir)

    run_data["requirements_version"] = version + 1
    run_data["requirements_status"] = "awaiting_user_review"
    run_data["approval"] = {
        "status": "pending",
        "approved_version": None,
        "approved_at": None
    }
    run_data["next_stage_allowed"] = False
    write_yaml(run_file, run_data)

    print(f"Success: Specification updated to Version {version + 1}.\n")
    print("=== Diff (Before vs After Modification) ===")
    diff = difflib.unified_diff(
        old_content.splitlines(keepends=True),
        new_content.splitlines(keepends=True),
        fromfile=f"spec.md (v{version})",
        tofile=f"spec.md (v{version+1})"
    )
    sys.stdout.writelines(diff)

