def validate_design_draft(draft):
    required_top = {
        "design_version", "selected_direction", "status", "review_status", "screens",
        "sections", "source_references", "allowed_modifications", "locked_global_properties",
    }
    missing = required_top - set(draft)
    if missing:
        raise ValueError(f"Design Draft missing fields: {sorted(missing)}")
    if draft["selected_direction"] != "MIX-1" or draft["status"] != "edit_draft":
        raise ValueError("Design Draft must preserve MIX-1 in edit_draft state.")
    screen_ids = {screen["id"] for screen in draft["screens"]}
    if screen_ids != {"HOME", "WORKSPACE"}:
        raise ValueError("Design Draft requires HOME and WORKSPACE screens.")
    section_ids = set(draft["sections"])
    required_sections = {
        "HOME-NAV", "HOME-PROJECTS", "HOME-NEXT-ACTION", "WORKSPACE-NAV",
        "WORKSPACE-REQUEST", "WORKSPACE-STATUS", "WORKSPACE-PREVIEW",
        "WORKSPACE-ACTIONS", "WORKSPACE-DETAILS",
    }
    if section_ids != required_sections:
        raise ValueError("Design Draft section IDs are incomplete or unexpected.")
    for screen in draft["screens"]:
        order = screen.get("layout_order", [])
        if len(order) != len(set(order)) or any(section_id not in section_ids for section_id in order):
            raise ValueError(f"Invalid layout_order for screen {screen.get('id')}.")
    for section_id, section in draft["sections"].items():
        for field in ("name", "screen_id", "source_reference_ids", "editable_properties", "locked_properties", "order", "mobile_behavior", "status"):
            if field not in section:
                raise ValueError(f"Section {section_id} missing {field}.")
    for reference in draft["source_references"]:
        if reference.get("registered_in_reference_library") is not False:
            raise ValueError("Imported references must not be auto-registered.")
        if any(section_id not in section_ids for section_id in reference.get("applied_section_ids", [])):
            raise ValueError(f"Reference points to an unknown section: {reference.get('id')}")
    return True


