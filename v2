def load_pm4_research_state(v2_root):
    state_path = os.path.join(v2_root, PM4_STATE_RELATIVE_PATH)
    if not os.path.exists(state_path):
        raise ValueError("PM4 Core state has not been built yet.")
    state = load_json_file(state_path)
    if state.get("request_id") != PM4_REQUEST_ID:
        raise ValueError("PM4 research request does not match the confirmed interview.")
    if state.get("period_days") != 30:
        raise ValueError("PM4 research period must be the confirmed recent 30 days.")
    if not isinstance(state.get("items"), list) or not isinstance(state.get("decisions"), dict):
        raise ValueError("PM4 research state is incomplete.")
    item_ids = {item.get("item_id") for item in state["items"]}
    if None in item_ids or len(item_ids) != len(state["items"]):
        raise ValueError("PM4 result ids are invalid or duplicated.")
    if not set(state["decisions"]).issubset(item_ids):
        raise ValueError("PM4 decision points to an unknown result.")
    if not set(state["decisions"].values()).issubset(PM4_DECISIONS):
        raise ValueError("PM4 decision contains an unsupported value.")
    return state


