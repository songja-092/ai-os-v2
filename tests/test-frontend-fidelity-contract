#!/usr/bin/env python3
import copy
import subprocess
import tempfile
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parent.parent
VERIFY = ROOT / "tools/verify-frontend-fidelity-contract"
SOURCE = ROOT / "contracts/frontend-implementation-fidelity.yml"

valid = subprocess.run([str(VERIFY)], cwd=ROOT, capture_output=True, text=True)
assert valid.returncode == 0, valid.stdout + valid.stderr

contract = yaml.safe_load(SOURCE.read_text(encoding="utf-8"))
invalid = copy.deepcopy(contract)
invalid["principles"]["role_or_file_presence_is_sufficient"] = True
with tempfile.TemporaryDirectory() as tmp:
    target = Path(tmp) / "invalid.yml"
    target.write_text(yaml.safe_dump(invalid, allow_unicode=True, sort_keys=False), encoding="utf-8")
    rejected = subprocess.run([str(VERIFY), str(target)], cwd=ROOT, capture_output=True, text=True)
    assert rejected.returncode != 0, "invalid sufficiency rule was accepted"

print("test_frontend_fidelity_contract: PASS")
