#!/usr/bin/env python3
from __future__ import annotations

import json
import subprocess
import tempfile
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
RESOLVER = ROOT / "tools/resolve-product-harness"
CONTRACT = ROOT / "pm5-artifacts/electronic-business-card-v1/product-contract.v1.json"
STORY_BOARD_CONTRACT = ROOT / "story-board-artifacts/m1/product-contract.draft.json"
REGISTRY = ROOT / "product-harness-registry.json"
KNOWLEDGE_CONTRACT = ROOT / "test-fixtures/core-reuse/knowledge-checklist-contract.json"


def run(contract: Path, registry: Path) -> tuple[int, dict]:
    result = subprocess.run(
        [str(RESOLVER), "--contract", str(contract), "--registry", str(registry)],
        cwd=ROOT,
        capture_output=True,
        text=True,
        check=False,
    )
    return result.returncode, json.loads(result.stdout)


def write(path: Path, data: dict) -> None:
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


code, plan = run(CONTRACT, REGISTRY)
assert code == 0, plan
assert plan["technical_verdict"] == "RESOLVED_CONTRACT_ONLY"
assert plan["execution_allowed"] is True
assert plan["missing_capabilities"] == []
assert plan["uncovered_machine_gates"] == []
assert plan["pending_user_approvals"] == []

# A second, structurally different product must resolve through the same Core
# resolver without product-specific branching in the resolver itself.
code, story_plan = run(STORY_BOARD_CONTRACT, REGISTRY)
assert code == 0, story_plan
assert story_plan["technical_verdict"] == "RESOLVED_CONTRACT_ONLY"
assert story_plan["project_type"] == "story_board"
assert story_plan["profile"] == "story_board.m1"
assert story_plan["missing_capabilities"] == []
assert story_plan["uncovered_machine_gates"] == []
assert story_plan["execution_allowed"] is False
assert story_plan["pending_user_approvals"] == ["final_result", "visual_target"]

with tempfile.TemporaryDirectory(prefix="v2-product-harness-") as temporary:
    root = Path(temporary)
    registry = json.loads(REGISTRY.read_text(encoding="utf-8"))

    pending_contract = json.loads(CONTRACT.read_text(encoding="utf-8"))
    pending_contract["approval"]["final_result"] = "pending"
    pending_contract_path = root / "pending-contract.json"
    write(pending_contract_path, pending_contract)
    code, result = run(pending_contract_path, REGISTRY)
    assert code == 0
    assert result["execution_allowed"] is True
    assert result["pending_user_approvals"] == ["final_result"]

    ambiguous = json.loads(json.dumps(registry))
    duplicate = json.loads(json.dumps(ambiguous["profiles"][0]))
    duplicate["id"] = "electronic_business_card.duplicate"
    ambiguous["profiles"].append(duplicate)
    ambiguous_path = root / "ambiguous.json"
    write(ambiguous_path, ambiguous)
    code, result = run(CONTRACT, ambiguous_path)
    assert code == 2
    assert result["reason"] == "profile_match_must_be_exactly_one"

    missing = json.loads(json.dumps(registry))
    for adapter in missing["adapters"]:
        if adapter["id"] == "portrait-composer.v1":
            adapter["evidence"] = ["missing/portrait-evidence.json"]
    missing_path = root / "missing-evidence.json"
    write(missing_path, missing)
    code, result = run(CONTRACT, missing_path)
    assert code == 2
    assert result["technical_verdict"] == "BLOCKED"
    assert set(result["missing_capabilities"]) == {"portrait.optional", "portrait.composition"}

    unknown_contract = json.loads(CONTRACT.read_text(encoding="utf-8"))
    unknown_contract["project_type"] = "unknown_product"
    unknown_path = root / "unknown-contract.json"
    write(unknown_path, unknown_contract)
    code, result = run(unknown_path, REGISTRY)
    assert code == 2
    assert result["reason"] == "profile_match_must_be_exactly_one"


# The third type is now a persistent isolated runtime fixture, not only a
# temporary registry-extensibility example.
code, result = run(KNOWLEDGE_CONTRACT, REGISTRY)
assert code == 0, result
assert result["technical_verdict"] == "RESOLVED_CONTRACT_ONLY"
assert result["profile"] == "knowledge_checklist.v1"
assert result["evidence_scope"] == "multi_product_runtime"
assert result["selected_adapters"] == ["knowledge-checklist-core.v1"]
assert {item["classification"] for item in result["selected_verifiers"]} == {"contract_only", "runtime"}
assert result["missing_capabilities"] == []
assert result["uncovered_machine_gates"] == []

print("product-harness resolver fixtures: PASS")
