#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
stage_root="$(mktemp -d)"
cleanup() {
  git -C "$repo_root" worktree remove --force "$stage_root" >/dev/null 2>&1 || true
}
trap cleanup EXIT

git -C "$repo_root" worktree add --detach "$stage_root" HEAD >/dev/null

paths=(
  SYSTEM_STATE.yml
  contracts/frontend-implementation-fidelity.yml
  schemas/frontend-implementation-fidelity.schema.json
  schemas/system-state.schema.json
  test-fixtures/frontend-fidelity/fixture-contract.json
  test-fixtures/frontend-fidelity/index.html
  tools/verify-frontend-fidelity-contract
  tools/verify-frontend-fidelity-fixture
  tests/test-frontend-fidelity-contract
  tests/test-frontend-fidelity-fixture
)

for path in "${paths[@]}"; do
  mkdir -p "$stage_root/$(dirname "$path")"
  cp -a "$repo_root/$path" "$stage_root/$path"
done

cd "$stage_root"
tests/test-frontend-fidelity-contract >/dev/null
tests/test-frontend-fidelity-fixture >/dev/null

fixture="test-fixtures/frontend-fidelity/index.html"
cp "$fixture" "$fixture.previous"
sed -i 's/data-testid="restore"/data-testid="restore-broken"/' "$fixture"
if tools/verify-frontend-fidelity-fixture >/dev/null 2>&1; then
  echo "frontend_fidelity_staging_rehearsal: FAIL"
  echo "reason: injected_failure_not_detected"
  exit 1
fi
mv "$fixture.previous" "$fixture"
tools/verify-frontend-fidelity-fixture >/dev/null

printf 'frontend_fidelity_staging_rehearsal: PASS\n'
printf 'failure_detection: PASS\n'
printf 'previous_version_restore: PASS\n'
printf 'isolation: temporary_detached_worktree\n'
printf 'production_changed: false\n'
