#!/usr/bin/env python3
import subprocess
import sys
from pathlib import Path

import yaml

root = Path(__file__).resolve().parent.parent
plan = yaml.safe_load((root / "operations/control-plane-release.yml").read_text(encoding="utf-8"))
release = plan["release"]
required = {"staging_rehearsal", "user_production_approval", "production_deploy", "previous_version_restore"}
gates = set(release.get("gates", []))

if not required.issubset(gates):
    print("control_plane_release: FAIL\nreason: required_gate_missing")
    sys.exit(1)
if release["production"]["status"] not in {"waiting_user_approval", "deployed"}:
    print("control_plane_release: FAIL\nreason: production_status_invalid")
    sys.exit(1)
if release["staging"]["status"] != "passed":
    print("control_plane_release: FAIL\nreason: staging_not_passed")
    sys.exit(1)
if release["restore"]["strategy"] != "previous_git_commit" or not release["restore"]["required"]:
    print("control_plane_release: FAIL\nreason: restore_contract_missing")
    sys.exit(1)
if subprocess.run(["git", "-C", str(root), "rev-parse", "HEAD^"], capture_output=True).returncode != 0:
    print("control_plane_release: FAIL\nreason: previous_version_missing")
    sys.exit(1)

verdict = "OPERATIONAL_SYSTEM_COMPLETE" if release["production"]["status"] == "deployed" and release["restore"]["status"] == "passed" else "READY_FOR_PRODUCTION_GATE"
print(f"control_plane_release: {verdict}")
print(f"production: {release['production']['status']}")
print("restore: previous_git_commit")
