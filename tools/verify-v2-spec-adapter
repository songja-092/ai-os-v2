#!/usr/bin/env python3
"""Validate a V2 Spec Lite artifact without modifying it."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("artifact")
    args = parser.parse_args()

    path = Path(args.artifact)
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        print(json.dumps({"verdict": "BLOCKED", "error": str(error)}, ensure_ascii=False))
        return 2

    checks = {
        "original_request_preserved": bool(data.get("original_request")),
        "smallest_mode_selected": data.get("mode") in {"spec_lite", "spec_full"},
        "target_resolved": bool(data.get("target", {}).get("section_id")),
        "bounded_change": bool(data.get("change", {}).get("command")),
        "preserve_contract_present": bool(data.get("preserve")),
        "done_when_present": bool(data.get("done_when")),
        "regression_checks_present": bool(data.get("regression_checks")),
        "approval_required": data.get("approval", {}).get("required") is True,
        "implementation_not_implied": data.get("implementation_performed") is False,
    }
    blocking = [name for name, passed in checks.items() if not passed]
    result = {
        "tool": "verify-v2-spec-adapter",
        "mode": "read_only",
        "artifact": str(path.resolve()),
        "verdict": "PASS" if not blocking else "BLOCKED",
        "checks": checks,
        "blocking": blocking,
    }
    print(json.dumps(result, ensure_ascii=False, indent=2))
    return 0 if not blocking else 2


if __name__ == "__main__":
    sys.exit(main())
