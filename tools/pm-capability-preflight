#!/usr/bin/env python3
"""Read-only readiness check for the removable V2 capability environment."""

from __future__ import annotations

import json
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[1]
CATALOG = ROOT / "plugins/v2-capability-lab/registry/candidate-catalog.json"
REGISTRY = ROOT / "plugins/v2-capability-lab/registry/capabilities.json"
PLUGIN = ROOT / "plugins/v2-capability-lab/.codex-plugin/plugin.json"
SKILL = ROOT / "plugins/v2-capability-lab/skills/v2-capability-lab/SKILL.md"
FINISH_SKILL = ROOT / ".agents/skills/v2-design-finish/SKILL.md"


def load(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def main() -> int:
    failures: list[str] = []
    checks: list[str] = []
    for path in (CATALOG, REGISTRY, PLUGIN, SKILL, FINISH_SKILL):
        if path.is_file():
            checks.append(f"PASS file {path.relative_to(ROOT)}")
        else:
            failures.append(f"FAIL missing {path.relative_to(ROOT)}")

    if failures:
        print("\n".join(checks + failures))
        return 1

    catalog = load(CATALOG)
    registry = load(REGISTRY)
    candidates = catalog.get("candidates", [])
    ids = [item.get("id") for item in candidates]
    if catalog.get("schema_version") != "1.0" or not candidates:
        failures.append("FAIL candidate catalog schema or candidates")
    elif len(ids) != len(set(ids)):
        failures.append("FAIL duplicate candidate id")
    else:
        checks.append(f"PASS candidate catalog {len(candidates)} entries")

    if any(item.get("install_allowed_now") is True for item in candidates):
        failures.append("FAIL environment must not pre-authorize candidate installation")
    else:
        checks.append("PASS no candidate installation pre-authorized")

    catalog_ids = set(ids)
    for item in registry.get("capabilities", []):
        candidate_id = item.get("candidate_id")
        if candidate_id not in catalog_ids:
            failures.append(f"FAIL adopted capability missing from catalog: {candidate_id}")
        if item.get("adapter_enabled") is not False:
            failures.append(f"FAIL capability unexpectedly enabled: {candidate_id}")
        if item.get("core_write_allowed") is not False or item.get("private_project_access") is not False:
            failures.append(f"FAIL capability boundary violated: {candidate_id}")
    if registry.get("capabilities") and not failures:
        checks.append(f"PASS inactive adopted registry {len(registry['capabilities'])} entries")

    print("\n".join(checks + failures))
    print(f"RESULT {'PASS' if not failures else 'BLOCKED'}")
    return 0 if not failures else 1


if __name__ == "__main__":
    raise SystemExit(main())
