#!/usr/bin/env python3
"""Verify PM4 local-first collector artifacts without network access."""

from __future__ import annotations

import json
from pathlib import Path
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parents[1]
SCRIPT = ROOT / "plugins/v2-capability-lab/scripts/pm4_collector.py"
INTERVIEW = ROOT / "plugins/v2-capability-lab/scripts/pm4_interview.py"
ANALYZER = ROOT / "plugins/v2-capability-lab/scripts/pm4_analyzer.py"
FIXTURES = ROOT / "pm4-artifacts/local-first-pilot-v1/fixtures"


def collect(request: str, output: Path) -> dict:
    subprocess.run(
        [sys.executable, str(SCRIPT), "run", "--repo", str(ROOT), "--request-file", str(FIXTURES / request), "--output", str(output)],
        check=True,
        stdout=subprocess.DEVNULL,
    )
    return json.loads(output.read_text(encoding="utf-8"))


def analyze(request: str, collection: Path, output: Path) -> dict:
    subprocess.run(
        [sys.executable, str(ANALYZER), "--request-file", str(FIXTURES / request), "--collection-file", str(collection), "--output", str(output)],
        check=True,
        stdout=subprocess.DEVNULL,
    )
    return json.loads(output.read_text(encoding="utf-8"))


def main() -> int:
    checks: list[tuple[str, bool]] = []
    with tempfile.TemporaryDirectory(prefix="pm4-verify-") as folder:
        target = Path(folder)
        local_path = target / "local-collection.json"
        missing_path = target / "missing-collection.json"
        local_collection = collect("local-sufficient-request.json", local_path)
        missing_collection = collect("external-needed-request.json", missing_path)
        local = analyze("local-sufficient-request.json", local_path, target / "local-analysis.json")
        missing = analyze("external-needed-request.json", missing_path, target / "missing-analysis.json")
        checks.extend([
            ("interview is confirmed before collection", local_collection["interview_status"] == "confirmed"),
            ("collector only collects", local_collection["quality_judgment"] is None and local_collection["adoption_decision"] is None),
            ("analyzer summarizes facts without sufficiency judgment", local["role"] == "fact_summary_not_sufficiency_not_adoption" and local["sufficiency_judgment"] is None),
            ("each result has a link and short summary", all(item.get("link") and item.get("short_summary") for item in local["results"])),
            ("user decides whether collection is enough", local["user_review"]["decision"] is None and "자료 더 찾기" in local["user_review"]["choices"]),
            ("external network is never automatic", missing_collection["automatic_network_execution"] is False),
            ("private project upload is prohibited", missing_collection["private_project_upload"] is False),
            ("analyzer cannot recommend or adopt", local["recommendation"] is None and local["adoption_decision"] is None and missing["recommendation"] is None),
            ("no install, activation, or Core mutation", not any(local_collection["side_effects"].values()) and not any(missing_collection["side_effects"].values())),
        ])
    failures = [name for name, passed in checks if not passed]
    print(json.dumps({"checks": [{"name": name, "status": "PASS" if passed else "FAIL"} for name, passed in checks], "verdict": "PASS" if not failures else "FAIL"}, ensure_ascii=False, indent=2))
    return 1 if failures else 0


if __name__ == "__main__":
    raise SystemExit(main())
