#!/usr/bin/env python3
"""Verify PM4 local-first collector artifacts without network access."""

from __future__ import annotations

import json
from pathlib import Path
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parents[1]
SCRIPT = ROOT / "plugins/v2-capability-lab/scripts/pm4_collector.py"
FIXTURES = ROOT / "pm4-artifacts/local-first-pilot-v1/fixtures"


def run(request: str, output: Path) -> dict:
    subprocess.run(
        [sys.executable, str(SCRIPT), "run", "--repo", str(ROOT), "--request-file", str(FIXTURES / request), "--output", str(output)],
        check=True,
        stdout=subprocess.DEVNULL,
    )
    return json.loads(output.read_text(encoding="utf-8"))


def main() -> int:
    checks: list[tuple[str, bool]] = []
    with tempfile.TemporaryDirectory(prefix="pm4-verify-") as folder:
        target = Path(folder)
        local = run("local-sufficient-request.json", target / "local.json")
        missing = run("external-needed-request.json", target / "missing.json")
        checks.extend([
            ("local assets searched first", local["policy"] == "local_first_external_only_if_missing"),
            ("sufficient local case skips external research", local["external_research_needed"] is False),
            ("missing case creates bounded external request", missing["external_research_needed"] is True and bool(missing["external_research"]["queries"])),
            ("external network is never automatic", missing["external_research"]["automatic_network_execution"] is False),
            ("private project upload is prohibited", missing["external_research"]["private_project_upload"] is False),
            ("collector cannot adopt automatically", local["decision"]["requires_user"] is True and local["decision"]["current"] is None),
            ("no install, activation, or Core mutation", not any(local["side_effects"].values()) and not any(missing["side_effects"].values())),
        ])
    failures = [name for name, passed in checks if not passed]
    print(json.dumps({"checks": [{"name": name, "status": "PASS" if passed else "FAIL"} for name, passed in checks], "verdict": "PASS" if not failures else "FAIL"}, ensure_ascii=False, indent=2))
    return 1 if failures else 0


if __name__ == "__main__":
    raise SystemExit(main())
