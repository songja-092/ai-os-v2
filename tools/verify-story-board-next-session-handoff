#!/usr/bin/env python3
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
HANDOFF = ROOT / "wiki" / "STORY_BOARD_NEXT_SESSION_HANDOFF.md"

required = [
    "스토리 보드 M2 다음 세션 단일 인계 지시서",
    "story-board-m1-result-v1",
    "M1_foundation_pass / M2_internal_fixture_allowed / visual_target_approval_pending",
    "M2 인터뷰 최소화",
    "첫 유료 상품과 시험 가격 범위",
    "선호하는 디자인과 피해야 할 디자인",
    "첫 실제 사용자 모집 채널과 인원 범위",
    "M2 내부 Fixture",
    "implementation_allowed: false",
    "Story Profile + Scene Contract",
    "수집기 개선 계약",
    "같은 입력으로 V2 수집기 재실행",
    "V2_CODEX_PLUGIN_ADOPTION_FOR_STORY_BOARD_2026-08-30.md",
    "Sites: M2에 사용하지 않고 M3",
    "플러그인은 Core가 아니라 교체 가능한 Adapter",
    "첫 사용자 개입: Visual Target 방향 승인",
    "다음 사용자 개입: Production 배포 승인",
    "Runtime·공개·결제·수익은 아직 not_proven",
]

errors = []
if not HANDOFF.exists():
    errors.append(f"missing: {HANDOFF.relative_to(ROOT)}")
    text = ""
else:
    text = HANDOFF.read_text(encoding="utf-8")
    for phrase in required:
        if phrase not in text:
            errors.append(f"missing contract phrase: {phrase}")

plugin_contract = ROOT / "wiki" / "V2_CODEX_PLUGIN_ADOPTION_FOR_STORY_BOARD_2026-08-30.md"
if not plugin_contract.exists():
    errors.append(f"missing: {plugin_contract.relative_to(ROOT)}")
else:
    plugin_text = plugin_contract.read_text(encoding="utf-8")
    for phrase in [
        "runtime_integration_not_proven",
        "Story M2 | Presentations",
        "Story M3 | Sites",
        "현재 저장소에는 `.openai/hosting.json`이 없으므로",
        "Sites는 M3 이전에 설치·초기화·배포하지 않습니다.",
    ]:
        if phrase not in plugin_text:
            errors.append(f"missing plugin contract phrase: {phrase}")

def git(*args):
    return subprocess.check_output(["git", "-C", str(ROOT), *args], text=True).strip()

try:
    tag_commit = git("rev-list", "-n", "1", "story-board-m1-result-v1")
    expected = "edd0d299974b33d571c3f212188efa4ad2a7e0d3"
    if tag_commit != expected:
        errors.append(f"M1 tag mismatch: {tag_commit} != {expected}")
    head = git("rev-parse", "HEAD")
    ancestor = subprocess.run(
        ["git", "-C", str(ROOT), "merge-base", "--is-ancestor", tag_commit, head],
        check=False,
    ).returncode == 0
    if not ancestor:
        errors.append("M1 result tag is not an ancestor of current HEAD")
except (subprocess.CalledProcessError, FileNotFoundError) as exc:
    errors.append(f"git verification failed: {exc}")

if errors:
    print("BLOCKED_STORY_BOARD_HANDOFF")
    for error in errors:
        print(f"- {error}")
    sys.exit(1)

print("PASS_STORY_BOARD_NEXT_SESSION_HANDOFF")
print(f"handoff: {HANDOFF.relative_to(ROOT)}")
print("next: M2 internal fixture without another interview")
print("user_gate_1: visual target direction approval")
print("user_gate_2: production deployment approval")
print("runtime_revenue: not_proven")
