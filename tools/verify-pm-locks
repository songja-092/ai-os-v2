#!/usr/bin/env bash
set -u
set -o pipefail

failures=0

check_sha() {
  expected="$1"
  target="$2"

  if [[ ! -f "$target" ]]; then
    echo "FAIL missing: $target"
    failures=$((failures + 1))
    return
  fi

  actual="$(sha256sum "$target" | cut -d ' ' -f 1)"
  if [[ "$actual" == "$expected" ]]; then
    echo "PASS locked: $target"
  else
    echo "FAIL changed: $target"
    failures=$((failures + 1))
  fi
}

