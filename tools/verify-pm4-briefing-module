#!/usr/bin/env python3
"""Verify the PM4 daily briefing Module contract."""
from __future__ import annotations
import json
from pathlib import Path

ROOT=Path(__file__).resolve().parents[1]
MANIFEST=ROOT/'pm4-modules/daily-discovery-briefing/manifest.json'
FIXTURE=ROOT/'pm4-modules/daily-discovery-briefing/fixture.json'

manifest=json.loads(MANIFEST.read_text(encoding='utf-8'))
fixture=json.loads(FIXTURE.read_text(encoding='utf-8'))
actions={item['action_type'] for item in manifest['emitted_actions']}
checks={
  'module id fixed':manifest['module_id']=='daily-discovery-briefing',
  'background slot allowed':'background_capability' in manifest['allowed_slots'],
  'config action permissioned':'briefing.config.update' in actions,
  'topic starts empty for user input':fixture['topic']=='',
  'schedule is user draft':fixture['schedule']['status']=='draft',
  'platforms start unselected':fixture['selected_platforms']==[],
  'five source labels present':{item['id'] for item in fixture['sources']}=={'github','reddit','youtube','threads','instagram'},
  'output has link and summary':all(item.get('url') and item.get('short_summary') for item in fixture['items']),
  'five-source pilot collection is recorded':next(x for x in manifest['features'] if x['feature_id']=='briefing.collect')['status']=='verified_five_source_pilot',
  'lifecycle remains candidate':manifest['status']['lifecycle']=='candidate',
}
print(json.dumps({'checks':[{'name':k,'status':'PASS' if v else 'FAIL'} for k,v in checks.items()],'verdict':'PASS' if all(checks.values()) else 'FAIL'},ensure_ascii=False,indent=2))
raise SystemExit(0 if all(checks.values()) else 1)
