#!/usr/bin/env python3
import copy, json, tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
source = json.loads((ROOT / "test-fixtures/core-reuse/knowledge-checklist-state.json").read_text(encoding="utf-8"))
original = copy.deepcopy(source)
with tempfile.TemporaryDirectory(prefix="v2-core-reuse-") as tmp:
    state_path = Path(tmp) / "state.json"
    state_path.write_text(json.dumps(source), encoding="utf-8")
    state = json.loads(state_path.read_text(encoding="utf-8"))
    state["items"].append({"id":"runtime","text":"독립 Runtime","completed":False})
    state["items"][1]["completed"] = True
    state_path.write_text(json.dumps(state), encoding="utf-8")
    assert len(json.loads(state_path.read_text())["items"]) == 2
    state_path.write_text(json.dumps(original), encoding="utf-8")
    assert json.loads(state_path.read_text()) == original
print("knowledge_checklist_runtime: PASS\nedit: PASS\nrestore: PASS\nproduct_files_changed: false")
