{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ai-os-v2.local/schemas/scene-contract.schema.json","type":"object","additionalProperties":false,
  "required":["schema_version","contract_id","status","source_sha256","scenes","warnings"],
  "properties":{
    "schema_version":{"const":"1.0"},"contract_id":{"type":"string","minLength":1},"status":{"enum":["draft","approved_locked"]},"source_sha256":{"pattern":"^[a-f0-9]{64}$"},
    "scenes":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["scene_id","order","title","body","source_slide","asset_refs","output_mapping","motion","audio"],"properties":{
      "scene_id":{"pattern":"^scene_[0-9]{3}$"},"order":{"type":"integer","minimum":1},"title":{"type":"string"},"body":{"type":"array","items":{"type":"string"}},"source_slide":{"type":"integer","minimum":1},
      "asset_refs":{"type":"array","items":{"type":"string"}},"output_mapping":{"type":"object","required":["slide","card","web","shot","page"]},"motion":{"enum":["none","candidate"]},"audio":{"enum":["none","slot_only"]}
    }}},"warnings":{"type":"array","items":{"type":"string"}}
  }
}
