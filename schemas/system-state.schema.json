{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os-v2.local/schemas/system-state.schema.json",
  "title": "AI OS V2 System State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state_revision", "recorded_at_commit", "system", "program", "locks", "products", "harness_policy", "capability_workstreams", "focus", "gates", "roadmap", "next_action"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "state_revision": {"type": "integer", "minimum": 1},
    "recorded_at_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "system": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "target", "canonical_repository", "canonical_branch"],
      "properties": {
        "id": {"const": "ai-os-v2"}, "name": {"type": "string", "minLength": 1},
        "target": {"const": "enterprise_control_plane"},
        "canonical_repository": {"const": "songja-092/ai-os-v2"},
        "canonical_branch": {"const": "main"}
      }
    },
    "program": {"type": "object", "required": ["active_program", "active_stage", "status"], "additionalProperties": {"type": ["string", "number", "boolean"]}},
    "locks": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object"}},
    "products": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object"}},
    "harness_policy": {"type": "object", "required": ["mode", "follow_planned_order", "active_bottlenecks", "completion_requires"], "additionalProperties": true},
    "capability_workstreams": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["planned_stages", "current_stage", "status", "next_stage", "blocker"],
        "properties": {
          "planned_stages": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["idea", "planning", "mockup", "static", "dynamic_runtime", "staging", "production", "restore"]}},
          "current_stage": {"type": "string"}, "status": {"enum": ["pending", "in_progress", "partial", "verified_limited", "blocked", "completed"]},
          "next_stage": {"type": "string"}, "blocker": {"type": "string"}
        }
      }
    },
    "focus": {"type": "object", "required": ["strategy", "active_workstream", "active_bottleneck", "priority_order"], "additionalProperties": true},
    "gates": {"type": "object", "required": ["session_preflight", "state_schema", "dirty_conflict", "protected_lock_change", "evidence_validation", "final_user_approval", "restore_validation"], "additionalProperties": {"type": "string"}},
    "roadmap": {
      "type": "object", "additionalProperties": false, "required": ["current_phase", "phases"],
      "properties": {
        "current_phase": {"type": "integer", "minimum": 1, "maximum": 4},
        "phases": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "status"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "status": {"enum": ["pending", "in_progress", "completed", "blocked"]}}}}
      }
    },
    "next_action": {"type": "object", "additionalProperties": false, "required": ["id", "description"], "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}}
  }
}
