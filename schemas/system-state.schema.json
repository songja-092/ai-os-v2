{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os-v2.local/schemas/system-state.schema.json",
  "title": "AI OS V2 System State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state_revision", "recorded_at_commit", "system", "program", "locks", "products", "harness_policy", "quality_policy", "capability_workstreams", "focus", "governance", "environments", "gates", "roadmap", "next_action"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "state_revision": {"type": "integer", "minimum": 1},
    "recorded_at_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "system": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "target", "canonical_repository", "canonical_branch"],
      "properties": {
        "id": {"const": "ai-os-v2"}, "name": {"type": "string", "minLength": 1},
        "target": {"const": "enterprise_control_plane"},
        "canonical_repository": {"const": "songja-092/ai-os-v2"},
        "canonical_branch": {"const": "main"}
      }
    },
    "program": {"type": "object", "required": ["active_program", "active_stage", "status"], "additionalProperties": {"type": ["string", "number", "boolean"]}},
    "locks": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object"}},
    "products": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object"}},
    "harness_policy": {"type": "object", "required": ["mode", "follow_planned_order", "active_bottlenecks", "completion_requires"], "additionalProperties": true},
    "quality_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_or_registration_is_sufficient", "evidence_documents_required", "sufficient_verdict_requires", "design_checks", "function_checks", "user_experience"],
      "properties": {
        "role_or_registration_is_sufficient": {"const": false},
        "evidence_documents_required": {"const": false},
        "sufficient_verdict_requires": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
        "design_checks": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
        "function_checks": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
        "user_experience": {
          "type": "object",
          "additionalProperties": false,
          "required": ["final_human_judgment_required", "objective_checks_cannot_be_replaced_by_role_presence"],
          "properties": {
            "final_human_judgment_required": {"const": true},
            "objective_checks_cannot_be_replaced_by_role_presence": {"const": true}
          }
        }
      }
    },
    "capability_workstreams": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["planned_stages", "current_stage", "status", "next_stage", "blocker"],
        "properties": {
          "planned_stages": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["idea", "planning", "mockup", "static", "dynamic_runtime", "staging", "production", "restore"]}},
          "current_stage": {"type": "string"}, "status": {"enum": ["pending", "in_progress", "partial", "verified_limited", "blocked", "completed"]},
          "next_stage": {"type": "string"}, "blocker": {"type": "string"}
        }
      }
    },
    "focus": {"type": "object", "required": ["strategy", "active_workstream", "active_bottleneck", "priority_order"], "additionalProperties": false, "properties": {"strategy": {"type": "string"}, "active_workstream": {"type": "string"}, "active_bottleneck": {"type": "string"}, "priority_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "governance": {
      "type": "object",
      "required": ["change_log", "roles", "approvals", "failure_isolation", "state_owner"],
      "additionalProperties": false,
      "properties": {
        "change_log": {"type": "string"},
        "roles": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object"}},
        "approvals": {
          "type": "object",
          "required": ["required_for", "automatic_for"],
          "additionalProperties": false,
          "properties": {
            "required_for": {"type": "array", "items": {"type": "string"}},
            "automatic_for": {"type": "array", "items": {"type": "string"}}
          }
        },
        "failure_isolation": {"const": "workstream"},
        "state_owner": {"const": "control_plane"}
      }
    },
    "environments": {"type": "object", "required": ["local", "staging", "production"], "additionalProperties": {"type": "object"}},
    "gates": {"type": "object", "required": ["session_preflight", "state_schema", "dirty_conflict", "protected_lock_change", "evidence_validation", "final_user_approval", "restore_validation"], "additionalProperties": {"type": "string"}},
    "roadmap": {
      "type": "object", "additionalProperties": false, "required": ["current_phase", "status", "phases"],
      "properties": {
        "current_phase": {"type": "integer", "minimum": 1, "maximum": 4},
        "status": {"enum": ["in_progress", "completed"]},
        "phases": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "status"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "status": {"enum": ["pending", "in_progress", "completed", "blocked"]}}}}
      }
    },
    "next_action": {"type": "object", "additionalProperties": false, "required": ["id", "description"], "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}}
  }
}
