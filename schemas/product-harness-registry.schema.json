{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os-v2.local/schemas/product-harness-registry.schema.json",
  "title": "AI OS V2 Product Harness Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profiles", "adapters", "verifiers"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "project_types", "required_capabilities", "required_gates", "evidence_scope"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "project_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "required_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "required_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence_scope": {"enum": ["fixture_specific", "single_product_runtime", "multi_product_runtime"]}
        }
      }
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "provides", "project_types", "side_effect", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "status": {"enum": ["candidate", "approved_inactive", "verified_limited", "disabled"]},
          "provides": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "project_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "side_effect": {"enum": ["read_only", "local_write", "network", "external_write", "cost"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "verifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "proves", "project_types", "classification", "side_effect"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "proves": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "project_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "classification": {"enum": ["contract_only", "fixture_specific", "runtime"]},
          "side_effect": {"enum": ["read_only", "temporary_with_restore"]}
        }
      }
    }
  }
}
