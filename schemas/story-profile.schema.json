{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ai-os-v2.local/schemas/story-profile.schema.json","type":"object","additionalProperties":false,
  "required":["schema_version","profile_id","status","source","purpose","audience","core_message","tone","rights","outputs"],
  "properties":{
    "schema_version":{"const":"1.0"},"profile_id":{"type":"string","minLength":1},"status":{"enum":["draft","approved_locked"]},
    "source":{"type":"object","additionalProperties":false,"required":["path","sha256","immutable"],"properties":{"path":{"type":"string"},"sha256":{"pattern":"^[a-f0-9]{64}$"},"immutable":{"const":true}}},
    "purpose":{"type":["string","null"]},"audience":{"type":["string","null"]},"core_message":{"type":["string","null"]},"tone":{"type":["string","null"]},
    "rights":{"enum":["fixture_public_or_synthetic","user_confirmed","unresolved"]},"outputs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}}
  }
}
